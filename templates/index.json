    "custom_liquid_yBcjUm": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ELORYA — Bloc 1 sous le bouton : bandeau Trustpilot + titre + carrousel UGC infini\n  Structure répliquée depuis tryelvera.com. CSS MOBILE FIRST.\n  À coller dans une section « Liquid personnalisé ».\n\n  Le défilement est en CSS pur (pas de JS). Les images sont dupliquées une fois\n  dans le DOM pour que la boucle soit invisible.\n{%- endcomment -%}\n\n{%- liquid\n  # ---------- RÉGLAGES ----------\n\n  assign trustpilot_img = \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/2_ed2e9635-430b-40d8-8d40-8f1ce830efdd_430x.png?v=1785285774#\"\n\n  assign titulo = \"Más de 12.000 mujeres ya la usan cada noche 💚\"\n\n  # Vitesse du défilement en secondes. Plus le chiffre est grand, plus c'est lent.\n  assign velocidad = 55\n\n  # Les 9 photos clientes, séparées par une barre verticale.\n  capture fotos_raw\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_27_03_430x.png?v=1785284862|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_27_01_430x.png?v=1785284863|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_59_430x.png?v=1785284862|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_57_430x.png?v=1785284862|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_49_430x.png?v=1785284861|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_54_430x.png?v=1785284860|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_47_430x.png?v=1785284862|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_52_430x.png?v=1785284860|\"\n    echo \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ChatGPT_Image_29_juil._2026_01_26_44_430x.png?v=1785284862\"\n  endcapture\n\n  assign fotos = fotos_raw | strip | split: '|'\n\n  # ---------- FIN DES RÉGLAGES ----------\n-%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n<section class=\"elorya-ugc\">\n\n  <header class=\"elorya-ugc__head\">\n    <img class=\"elorya-ugc__trust\" src=\"{{ trustpilot_img }}\" alt=\"Excelente 4,8 sobre 5 en Trustpilot\" loading=\"lazy\">\n    <h2 class=\"elorya-ugc__title\">{{ titulo }}</h2>\n  </header>\n\n  <div class=\"elorya-ugc__marquee\">\n    <div class=\"elorya-ugc__track\" style=\"--elorya-speed: {{ velocidad }}s;\">\n\n      {%- for foto in fotos -%}\n        <figure class=\"elorya-ugc__slide\">\n          <img src=\"{{ foto | strip }}\" alt=\"Clienta de ELORYA\" loading=\"lazy\">\n        </figure>\n      {%- endfor -%}\n\n      {%- comment -%} Copie identique : c'est elle qui rend la boucle invisible {%- endcomment -%}\n      {%- for foto in fotos -%}\n        <figure class=\"elorya-ugc__slide\" aria-hidden=\"true\">\n          <img src=\"{{ foto | strip }}\" alt=\"\" loading=\"lazy\">\n        </figure>\n      {%- endfor -%}\n\n    </div>\n  </div>\n\n</section>\n\n<style>\n  /* ══════════════════════════════\n     MOBILE FIRST — base = mobile\n     ══════════════════════════════ */\n\n  .elorya-ugc {\n    --e-title: #14140F;\n    --e-font: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\n\n    box-sizing: border-box;\n    width: 100%;\n    margin: 24px 0;\n    font-family: var(--e-font);\n    overflow: hidden;\n  }\n  .elorya-ugc *,\n  .elorya-ugc *::before,\n  .elorya-ugc *::after { box-sizing: border-box; }\n\n  /* ── En-tête ── */\n  .elorya-ugc__head {\n    text-align: center;\n    padding: 0 18px;\n    margin-bottom: 18px;\n  }\n\n  .elorya-ugc__trust {\n    display: block;\n    width: auto;\n    max-width: 230px;\n    height: auto;\n    margin: 0 auto 12px;\n  }\n\n  .elorya-ugc__title {\n    font-family: var(--e-font);\n    font-size: 21px;\n    font-weight: 400;\n    line-height: 1.25;\n    letter-spacing: -0.4px;\n    color: var(--e-title);\n    margin: 0;\n    max-width: 15ch;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* ── Carrousel infini ── */\n  .elorya-ugc__marquee {\n    width: 100%;\n    overflow: hidden;\n    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);\n    mask-image: linear-gradient(to right, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);\n  }\n\n  .elorya-ugc__track {\n    display: flex;\n    width: max-content;\n    gap: 10px;\n    animation: elorya-scroll var(--elorya-speed, 55s) linear infinite;\n  }\n  .elorya-ugc__marquee:hover .elorya-ugc__track {\n    animation-play-state: paused;\n  }\n\n  @keyframes elorya-scroll {\n    from { transform: translate3d(0, 0, 0); }\n    to   { transform: translate3d(-50%, 0, 0); }\n  }\n\n  .elorya-ugc__slide {\n    flex: 0 0 auto;\n    margin: 0;\n    padding: 0;\n    width: 190px;\n    border-radius: 10px;\n    overflow: hidden;\n    background: #F4F3EF;\n  }\n  .elorya-ugc__slide img {\n    width: 100%;\n    height: 100%;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    display: block;\n  }\n\n  /* Accessibilité : on coupe l'animation si l'utilisateur l'a désactivée */\n  @media (prefers-reduced-motion: reduce) {\n    .elorya-ugc__track { animation: none; }\n    .elorya-ugc__marquee {\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n      scrollbar-width: none;\n    }\n    .elorya-ugc__marquee::-webkit-scrollbar { display: none; }\n  }\n\n  /* ══════════════════════════════\n     DESKTOP — à partir de 750px\n     ══════════════════════════════ */\n\n  @media (min-width: 750px) {\n    .elorya-ugc { margin: 34px 0; }\n\n    .elorya-ugc__head { margin-bottom: 24px; }\n    .elorya-ugc__trust { max-width: 280px; margin-bottom: 14px; }\n    .elorya-ugc__title {\n      font-size: 32px;\n      max-width: 18ch;\n    }\n\n    .elorya-ugc__marquee {\n      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 90px, #000 calc(100% - 90px), transparent 100%);\n      mask-image: linear-gradient(to right, transparent 0, #000 90px, #000 calc(100% - 90px), transparent 100%);\n    }\n\n    .elorya-ugc__track { gap: 14px; }\n    .elorya-ugc__slide { width: 300px; border-radius: 12px; }\n  }\n</style>",
        "background": "",
