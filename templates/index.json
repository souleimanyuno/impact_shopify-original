            "liquid": "{%- comment -%} ELORYA — Bandeau 4 réassurances {%- endcomment -%} <style> .elo-reassure{ --elo-text:var(--elorya-text,#14140F); --elo-body:var(--elorya-body,#3A3A34); --elo-line:var(--elorya-line,#E6E6E2); --elo-green:var(--elorya-green,#2C4A35); font-family:var(--elorya-font,'Montserrat',-apple-system,BlinkMacSystemFont,sans-serif); display:grid;grid-template-columns:1fr 1fr;gap:1px; background:var(--elo-line);border:1px solid var(--elo-line); border-radius:14px;overflow:hidden;margin:20px 0; } .elo-reassure *{box-sizing:border-box} .elo-reassure__i{ background:#fff;padding:14px 10px; display:flex;flex-direction:column;align-items:center;text-align:center;gap:7px; } .elo-reassure__i svg{ width:21px;height:21px;stroke:var(--elo-green);fill:none; stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;display:block; } .elo-reassure__t{font-size:11.5px;line-height:1.3;font-weight:700;color:var(--elo-text);letter-spacing:-.01em} .elo-reassure__s{font-size:10.5px;line-height:1.35;color:var(--elo-body);opacity:.8;margin-top:-3px} @media (min-width:750px){ .elo-reassure{grid-template-columns:repeat(4,1fr)} .elo-reassure__i{padding:16px 12px} .elo-reassure__i svg{width:23px;height:23px} .elo-reassure__t{font-size:12.5px} .elo-reassure__s{font-size:11.5px} } </style> <div class=\"elo-reassure\"> <div class=\"elo-reassure__i\"> <svg viewBox=\"0 0 24 24\"><path d=\"M2.5 6.5h11v9h-11z\"/><path d=\"M13.5 9.5h4l3 3v3h-7z\"/><circle cx=\"6.5\" cy=\"18\" r=\"2\"/><circle cx=\"17\" cy=\"18\" r=\"2\"/></svg> <span class=\"elo-reassure__t\">Entrega en 3-5 días</span> <span class=\"elo-reassure__s\">Envío gratis</span> </div> <div class=\"elo-reassure__i\"> <svg viewBox=\"0 0 24 24\"><path d=\"M12 2.8l7.5 3v6c0 4.5-3.2 8.2-7.5 9.4-4.3-1.2-7.5-4.9-7.5-9.4v-6l7.5-3z\"/><path d=\"M8.8 12.2l2.2 2.2 4.2-4.4\"/></svg> <span class=\"elo-reassure__t\">30 días de prueba</span> <span class=\"elo-reassure__s\">O te devolvemos el dinero</span> </div> <div class=\"elo-reassure__i\"> <svg viewBox=\"0 0 24 24\"><path d=\"M20.5 8.5H7.5\"/><path d=\"M11 5l-3.5 3.5L11 12\"/><path d=\"M3.5 15.5h13\"/><path d=\"M13 12l3.5 3.5L13 19\"/></svg> <span class=\"elo-reassure__t\">Cambio de talla gratis</span> <span class=\"elo-reassure__s\">Si no te queda perfecta</span> </div> <div class=\"elo-reassure__i\"> <svg viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"10.5\" width=\"17\" height=\"10.5\" rx=\"2.5\"/><path d=\"M7.5 10.5V7.2a4.5 4.5 0 019 0v3.3\"/><path d=\"M12 14.8v2.4\"/></svg> <span class=\"elo-reassure__t\">Pago seguro</span> <span class=\"elo-reassure__s\">Bizum, tarjeta y PayPal</span> </div> </div>"
