          "settings": {
            "liquid": "{%- comment -%} ELORYA · BLOC 1A — Badge avis. Placer AU-DESSUS du titre produit. {%- endcomment -%}\n{%- assign ely_rating  = '4,8'   -%}\n{%- assign ely_reviews = '2.847' -%}\n\n<style>\n  .ely-rate{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 10px;\n    font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));}\n  .ely-rate__stars{display:inline-flex;gap:2px;line-height:0;}\n  .ely-rate__stars svg{width:19px;height:19px;fill:var(--ely-gold,#F0C417);display:block;}\n  .ely-rate__label{font-size:16px;font-weight:600;color:var(--ely-ink,#1A1A1A);letter-spacing:-.01em;}\n  @media(max-width:520px){.ely-rate__stars svg{width:17px;height:17px;}.ely-rate__label{font-size:15px;}}\n</style>\n\n<div class=\"ely-rate\">\n  <span class=\"ely-rate__stars\" aria-hidden=\"true\">\n    {%- for i in (1..5) -%}\n      <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z\"/></svg>\n    {%- endfor -%}\n  </span>\n  <span class=\"ely-rate__label\">Excelente {{ ely_rating }} | {{ ely_reviews }} Reseñas</span>\n</div>{%- comment -%}\n  ELORYA · BLOC 1B — Bullets + bouton \"Guía de tallas\" + modal calculadora.\n  Placer JUSTE SOUS le titre produit, au-dessus du bloc Kaching Bundles.\n{%- endcomment -%}\n{%- assign uid = block.id | default: section.id | default: 'ely1' -%}\n\n<style>\n  .ely-b1{font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));\n    color:var(--ely-ink,#1A1A1A);}\n  .ely-b1 *,.ely-b1 *::before,.ely-b1 *::after{box-sizing:border-box;}\n  .ely-b1__bullets{margin:16px 0 0;padding:0;list-style:none;}\n  .ely-b1__bullets li{font-size:15.5px;line-height:1.45;margin:0 0 7px;display:flex;gap:8px;align-items:flex-start;}\n  .ely-b1__bullets li::before{content:\"✓\";font-weight:700;color:var(--ely-ink,#1A1A1A);flex:0 0 auto;}\n  .ely-b1__sizebtn{font-family:inherit;background:none;border:none;cursor:pointer;font-size:16px;\n    font-weight:700;color:var(--ely-ink,#1A1A1A);display:inline-flex;align-items:center;gap:8px;\n    padding:0;margin:12px 0 0;text-underline-offset:3px;}\n  .ely-b1__sizebtn:hover{text-decoration:underline;}\n\n  .ely-sfmodal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:99999;\n    align-items:center;justify-content:center;padding:20px;}\n  .ely-sfmodal.is-open{display:flex;}\n  .ely-sfmodal__inner{position:relative;width:100%;max-width:480px;}\n  .ely-sfmodal__close{position:absolute;top:-40px;right:0;color:#fff;font-size:32px;line-height:1;\n    cursor:pointer;background:none;border:none;padding:0;font-family:sans-serif;}\n\n  .ely-sf{background:var(--ely-cream,#FAF3E9);border-radius:14px;padding:22px 20px;\n    font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));\n    color:var(--ely-ink,#1A1A1A);}\n  .ely-sf *,.ely-sf *::before,.ely-sf *::after{box-sizing:border-box;}\n  .ely-sf__grid{display:grid;grid-template-columns:1fr 1fr auto 1.1fr;gap:12px;align-items:end;}\n  .ely-sf__field{display:flex;flex-direction:column;gap:8px;}\n  .ely-sf__label{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;\n    color:var(--ely-ink,#1A1A1A);}\n  .ely-sf__select{width:100%;padding:12px 34px 12px 14px;border:1px solid #DCD1BF;border-radius:10px;\n    background:#fff;font-size:16px;font-weight:600;color:var(--ely-ink,#1A1A1A);font-family:inherit;\n    -webkit-appearance:none;appearance:none;cursor:pointer;\n    background-image:url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231A1A1A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e\");\n    background-repeat:no-repeat;background-position:right 12px center;background-size:14px;}\n  .ely-sf__select:focus{outline:2px solid var(--ely-ink,#1A1A1A);outline-offset:1px;}\n  .ely-sf__equals{font-size:22px;font-weight:700;padding:0 4px 14px;align-self:end;}\n  .ely-sf__result{padding:12px;border:2px solid var(--ely-ink,#1A1A1A);border-radius:10px;background:#fff;\n    font-size:22px;font-weight:800;text-align:center;letter-spacing:.5px;}\n  .ely-sf__hint{margin:16px 0 0;font-size:13.5px;line-height:1.5;}\n  .ely-sf__check{font-weight:700;margin-right:4px;}\n  .ely-sf__gift{margin:10px 0 0;padding:10px 12px;background:rgba(240,196,23,.18);border-radius:8px;\n    font-size:13px;line-height:1.4;display:flex;align-items:center;gap:8px;}\n  @media(max-width:520px){\n    .ely-sf{padding:18px 14px;}\n    .ely-sf__grid{gap:8px;}\n    .ely-sf__label{font-size:10px;letter-spacing:.4px;}\n    .ely-sf__select{padding:10px 26px 10px 10px;font-size:15px;}\n    .ely-sf__result{padding:10px;font-size:18px;}\n    .ely-sf__equals{padding:0 2px 12px;font-size:18px;}\n  }\n</style>\n\n<div class=\"ely-b1\">\n  <ul class=\"ely-b1__bullets\">\n    <li>Moldea una silueta perfecta</li>\n    <li>Sujeción firme sin aros</li>\n    <li>Invisible bajo cualquier prenda</li>\n  </ul>\n\n  <button type=\"button\" class=\"ely-b1__sizebtn\" data-ely-sf-open=\"{{ uid }}\"\n          aria-haspopup=\"dialog\">📏 Guía de tallas</button>\n</div>\n\n<div class=\"ely-sfmodal\" id=\"ely-sfmodal-{{ uid }}\" role=\"dialog\" aria-modal=\"true\"\n     aria-label=\"Guía de tallas\" data-ely-sf-modal>\n  <div class=\"ely-sfmodal__inner\">\n    <button type=\"button\" class=\"ely-sfmodal__close\" aria-label=\"Cerrar\" data-ely-sf-close>&times;</button>\n\n    <div class=\"ely-sf\" data-ely-sf>\n      <div class=\"ely-sf__grid\">\n        <div class=\"ely-sf__field\">\n          <label class=\"ely-sf__label\" for=\"ely-sf-c-{{ uid }}\">Contorno (cm)</label>\n          <select class=\"ely-sf__select\" id=\"ely-sf-c-{{ uid }}\" data-ely-sf-contorno>\n            <option value=\"70\">70</option><option value=\"75\">75</option>\n            <option value=\"80\">80</option><option value=\"85\" selected>85</option>\n            <option value=\"90\">90</option><option value=\"95\">95</option>\n            <option value=\"100\">100</option>\n          </select>\n        </div>\n\n        <div class=\"ely-sf__field\">\n          <label class=\"ely-sf__label\" for=\"ely-sf-k-{{ uid }}\">Copa</label>\n          <select class=\"ely-sf__select\" id=\"ely-sf-k-{{ uid }}\" data-ely-sf-copa>\n            <option value=\"A\">A</option><option value=\"B\" selected>B</option>\n            <option value=\"C\">C</option><option value=\"D\">D</option><option value=\"E\">E</option>\n          </select>\n        </div>\n\n        <div class=\"ely-sf__equals\" aria-hidden=\"true\">=</div>\n\n        <div class=\"ely-sf__field\">\n          <label class=\"ely-sf__label\">Tu talla</label>\n          <div class=\"ely-sf__result\" data-ely-sf-result aria-live=\"polite\">L</div>\n        </div>\n      </div>\n\n      <p class=\"ely-sf__hint\">\n        <span class=\"ely-sf__check\">✓</span>\n        La talla <strong data-ely-sf-size>L</strong> te queda bien si usas:\n        <span data-ely-sf-list>80D-E, 85A-C</span>\n      </p>\n\n      <p class=\"ely-sf__gift\">\n        <span>🎁</span>\n        <span><strong>Extensor gratis incluido</strong> si te queda demasiado ajustado</span>\n      </p>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var uid = {{ uid | json }};\n  var modal = document.getElementById('ely-sfmodal-' + uid);\n  if(!modal || modal.dataset.elyInit) return;\n  modal.dataset.elyInit = '1';\n\n  // Le modal est déplacé dans <body> : évite le clipping par les colonnes sticky d'Impact.\n  document.body.appendChild(modal);\n\n  var root       = modal.querySelector('[data-ely-sf]');\n  var contornoEl = modal.querySelector('[data-ely-sf-contorno]');\n  var copaEl     = modal.querySelector('[data-ely-sf-copa]');\n  var resultEl   = modal.querySelector('[data-ely-sf-result]');\n  var sizeEl     = modal.querySelector('[data-ely-sf-size]');\n  var listEl     = modal.querySelector('[data-ely-sf-list]');\n\n  // Mapping fournisseur + tolérance d'élasticité. En cas d'overlap : la taille au-dessus.\n  var SIZE_MAP = {\n    '70A':'S','70B':'S','70C':'S','70D':'M','70E':'M',\n    '75A':'S','75B':'S','75C':'S','75D':'M','75E':'M',\n    '80A':'M','80B':'M','80C':'M','80D':'L','80E':'L',\n    '85A':'L','85B':'L','85C':'L','85D':'XL','85E':'XL',\n    '90A':'XL','90B':'XL','90C':'XL','90D':'XL','90E':'XL',\n    '95A':'XL','95B':'XL','95C':'XL','95D':'XL','95E':'XL',\n    '100A':'XL','100B':'XL','100C':'XL','100D':'XL','100E':'XL'\n  };\n\n  // Liste des combos compatibles, générée depuis SIZE_MAP (source unique de vérité).\n  var COMPATIBLE = (function(){\n    var groups = {};\n    Object.keys(SIZE_MAP).forEach(function(k){\n      var s = SIZE_MAP[k]; (groups[s] = groups[s] || []).push(k);\n    });\n    var out = {};\n    Object.keys(groups).forEach(function(s){\n      var byC = {};\n      groups[s].forEach(function(k){\n        var c = k.match(/^\\d+/)[0];\n        (byC[c] = byC[c] || []).push(k.slice(c.length));\n      });\n      out[s] = Object.keys(byC).sort(function(a,b){return +a - +b;}).map(function(c){\n        var cups = byC[c].sort();\n        if(cups.length === 5) return c + ' (A-E)';\n        if(cups.length === 1) return c + cups[0];\n        return c + cups[0] + '-' + cups[cups.length-1];\n      }).join(', ');\n    });\n    return out;\n  })();\n\n  function update(){\n    var size = SIZE_MAP[contornoEl.value + copaEl.value] || 'M';\n    resultEl.textContent = size;\n    sizeEl.textContent   = size;\n    listEl.textContent   = COMPATIBLE[size];\n  }\n  contornoEl.addEventListener('change', update);\n  copaEl.addEventListener('change', update);\n  update();\n\n  function open(){ modal.classList.add('is-open'); document.body.style.overflow='hidden'; contornoEl.focus(); }\n  function close(){ modal.classList.remove('is-open'); document.body.style.overflow=''; }\n\n  document.addEventListener('click', function(e){\n    var opener = e.target.closest('[data-ely-sf-open=\"'+uid+'\"]');\n    if(opener){ e.preventDefault(); open(); }\n  });\n  modal.addEventListener('click', function(e){\n    if(e.target === modal || e.target.closest('[data-ely-sf-close]')) close();\n  });\n  document.addEventListener('keydown', function(e){\n    if(e.key === 'Escape' && modal.classList.contains('is-open')) close();\n  });\n})();\n</script>"
