    "custom_liquid_RHWVX8": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ELORYA — Bloc « Consejo del experto »\n  Structure répliquée depuis tryelvera.com. CSS écrit en MOBILE FIRST.\n  À coller dans une section « Liquid personnalisé ».\n\n  ⚠ À REMPLIR AVANT MISE EN LIGNE :\n    experto_nombre  et  experto_especialidad\n{%- endcomment -%}\n\n{%- liquid\n  # ---------- RÉGLAGES ----------\n\n  assign experto_foto = \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/Product_Photo_1.png_1-min_430x.webp?v=1785283980\"\n\n  assign experto_fecha        = \"4 de octubre de 2025\"\n  assign experto_nombre       = \"Dr. Alejandro Ruiz\"\n  assign experto_especialidad = \"Especialista en gastroenterología y salud digestiva\"\n\n  assign experto_cita = \"La salud digestiva depende de mucho más que de lo que comes. Cuando la inflamación crónica y la falta de movilidad intestinal se instalan, incluso la alimentación más cuidada puede dejarte hinchada, cansada y sin respuestas. El aceite de ricino aplicado con compresión constante ofrece un enfoque natural y no invasivo: actúa desde fuera, respeta los ritmos del cuerpo y no fuerza nada. Es una forma segura de acompañar la digestión noche tras noche, sin purgas ni efectos agresivos.\"\n\n  assign cta_texto   = \"Pruébala sin riesgo\"\n  assign cta_linea_1 = \"Envío gratis incluido\"\n  assign cta_linea_2 = \"Garantía de 90 días\"\n\n  # ---------- FIN DES RÉGLAGES ----------\n-%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"elorya-expert\">\n\n  <article class=\"elorya-expert__card\">\n\n    <figure class=\"elorya-expert__media\">\n      <img src=\"{{ experto_foto }}\" alt=\"{{ experto_nombre }}\" loading=\"lazy\">\n    </figure>\n\n    <div class=\"elorya-expert__content\">\n      <p class=\"elorya-expert__date\">{{ experto_fecha }}</p>\n\n      <h2 class=\"elorya-expert__heading\">\n        Consejo de {{ experto_nombre }}<span class=\"elorya-expert__role\">{{ experto_especialidad }}</span>\n      </h2>\n\n      <blockquote class=\"elorya-expert__quote\">\n        &laquo;{{ experto_cita }}&raquo;\n      </blockquote>\n    </div>\n\n  </article>\n\n  <div class=\"elorya-expert__cta\">\n    <button type=\"button\" class=\"elorya-expert__btn\" data-elorya-scroll>{{ cta_texto }}</button>\n    <ul class=\"elorya-expert__reassure\">\n      <li>{{ cta_linea_1 }}</li>\n      <li>{{ cta_linea_2 }}</li>\n    </ul>\n  </div>\n\n</section>\n\n<style>\n  /* ══════════════════════════════════════\n     MOBILE FIRST — styles de base = mobile\n     ══════════════════════════════════════ */\n\n  .elorya-expert {\n    --e-green: #2C4A35;\n    --e-title: #14140F;\n    --e-body: #4A4A44;\n    --e-muted: #8A8A82;\n    --e-line: #E9E7E1;\n    --e-font: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\n\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 720px;\n    margin: 20px auto;\n    font-family: var(--e-font);\n  }\n  .elorya-expert *,\n  .elorya-expert *::before,\n  .elorya-expert *::after { box-sizing: border-box; }\n\n  .elorya-expert__card {\n    background: #FFFFFF;\n    border: 1px solid var(--e-line);\n    border-radius: 14px;\n    overflow: hidden;\n  }\n\n  /* Photo pleine largeur en haut de la carte */\n  .elorya-expert__media {\n    margin: 0;\n    padding: 0;\n    width: 100%;\n    background: #F4F3EF;\n  }\n  .elorya-expert__media img {\n    width: 100%;\n    height: auto;\n    aspect-ratio: 16 / 10;\n    object-fit: cover;\n    object-position: center 28%;\n    display: block;\n  }\n\n  .elorya-expert__content { padding: 18px 18px 22px; }\n\n  .elorya-expert__date {\n    font-family: var(--e-font);\n    font-size: 11px;\n    font-weight: 400;\n    color: var(--e-muted);\n    margin: 0 0 7px;\n    line-height: 1.3;\n  }\n\n  .elorya-expert__heading {\n    font-family: var(--e-font);\n    font-size: 16px;\n    font-weight: 800;\n    line-height: 1.3;\n    letter-spacing: -0.2px;\n    color: var(--e-title);\n    margin: 0 0 13px;\n  }\n  .elorya-expert__role {\n    display: block;\n    font-size: 12.5px;\n    font-weight: 600;\n    letter-spacing: 0.2px;\n    color: var(--e-green);\n    margin-top: 4px;\n  }\n\n  .elorya-expert__quote {\n    font-family: var(--e-font);\n    font-size: 12.5px;\n    font-style: italic;\n    font-weight: 400;\n    line-height: 1.72;\n    color: var(--e-body);\n    margin: 0;\n    padding: 0;\n    border: none;\n  }\n\n  /* ── CTA ── */\n  .elorya-expert__cta { margin-top: 18px; text-align: center; }\n\n  .elorya-expert__btn {\n    display: block;\n    width: 100%;\n    padding: 14px 20px;\n    background: var(--e-green);\n    color: #FFFFFF;\n    font-family: var(--e-font);\n    font-size: 13.5px;\n    font-weight: 700;\n    letter-spacing: 0.2px;\n    text-align: center;\n    border: none;\n    border-radius: 100px;\n    cursor: pointer;\n    -webkit-appearance: none;\n    appearance: none;\n    transition: opacity 0.2s ease, transform 0.15s ease;\n  }\n  .elorya-expert__btn:hover { opacity: 0.9; }\n  .elorya-expert__btn:active { transform: scale(0.99); }\n\n  .elorya-expert__reassure {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 6px 18px;\n    list-style: none;\n    margin: 12px 0 0;\n    padding: 0;\n  }\n  .elorya-expert__reassure li {\n    position: relative;\n    padding-left: 16px;\n    font-size: 11px;\n    font-weight: 500;\n    color: var(--e-body);\n    line-height: 1.3;\n    list-style: none;\n  }\n  .elorya-expert__reassure li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 50%;\n    width: 10px;\n    height: 5.5px;\n    margin-top: -3.5px;\n    border-left: 1.8px solid var(--e-green);\n    border-bottom: 1.8px solid var(--e-green);\n    transform: rotate(-45deg);\n  }\n\n  /* ══════════════════════════════════════\n     TABLETTE ET DESKTOP — à partir de 750px\n     ══════════════════════════════════════ */\n\n  @media (min-width: 750px) {\n    .elorya-expert { margin: 26px auto; }\n\n    .elorya-expert__card {\n      display: flex;\n      align-items: stretch;\n      gap: 0;\n    }\n\n    .elorya-expert__media {\n      flex: 0 0 40%;\n      max-width: 40%;\n    }\n    .elorya-expert__media img {\n      height: 100%;\n      aspect-ratio: auto;\n      object-position: center 25%;\n      min-height: 260px;\n    }\n\n    .elorya-expert__content {\n      flex: 1;\n      min-width: 0;\n      padding: 26px 28px;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n    }\n\n    .elorya-expert__date { font-size: 11.5px; margin-bottom: 8px; }\n\n    .elorya-expert__heading { font-size: 19px; margin-bottom: 14px; }\n    .elorya-expert__role { font-size: 13.5px; margin-top: 5px; }\n\n    .elorya-expert__quote { font-size: 13.5px; line-height: 1.68; }\n\n    .elorya-expert__cta { margin-top: 22px; }\n    .elorya-expert__btn { font-size: 14.5px; padding: 15px 22px; }\n    .elorya-expert__reassure { gap: 6px 20px; margin-top: 13px; }\n    .elorya-expert__reassure li { font-size: 11.5px; padding-left: 17px; }\n    .elorya-expert__reassure li::before { width: 11px; height: 6px; margin-top: -4px; }\n  }\n</style>\n\n<script>\n(function(){\n  var SELECTORS = [\n    'form[action*=\"/cart/add\"]',\n    'product-form',\n    '.product-form',\n    '[name=\"add\"]',\n    '.shopify-payment-button',\n    '.product__info-wrapper',\n    '#MainContent'\n  ];\n\n  function findTarget(){\n    for (var i = 0; i < SELECTORS.length; i++) {\n      var el = document.querySelector(SELECTORS[i]);\n      if (el) return el;\n    }\n    return null;\n  }\n\n  document.querySelectorAll('[data-elorya-scroll]').forEach(function(btn){\n    if (btn.dataset.eloryaBound) return;\n    btn.dataset.eloryaBound = '1';\n    btn.addEventListener('click', function(){\n      var target = findTarget();\n      if (!target) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }\n      var y = target.getBoundingClientRect().top + window.pageYOffset - 90;\n      window.scrollTo({ top: y, behavior: 'smooth' });\n    });\n  });\n})();\n</script>",
