xt {\n    font-family: var(--elorya-font);\n    font-size: 20px;\n    font-weight: 400;\n    line-height: 1.35;\n    color: var(--elorya-text);\n    letter-spacing: 0;\n  }\n\n  .elorya-benefits__notice {\n    margin-top: 24px;\n    padding: 18px 22px;\n    background: var(--elorya-notice-bg);\n    border: 2px dashed var(--elorya-notice-border);\n    border-radius: 10px;\n    font-family: var(--elorya-font);\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.5;\n    color: var(--elorya-text);\n  }\n\n  @media (max-width: 749px) {\n    .elorya-benefits {\n      margin: 18px 0 22px;\n    }\n\n    .elorya-benefits__item {\n      gap: 14px;\n      margin-bottom: 20px;\n    }\n\n    .elorya-benefits__icon {\n      flex: 0 0 38px;\n      width: 38px;\n      height: 38px;\n    }\n\n    .elorya-benefits__text {\n      font-size: 14px;\n      line-height: 1.3;\n    }\n\n    .elorya-benefits__notice {\n      margin-top: 20px;\n      padding: 15px 17px;\n      font-size: 13px;\n    }\n  }\n</style>"
