    "custom_liquid_TNiQNU": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ELORYA — Bloc « La fórmula » : double titre + 3 micro-badges + 4 bénéfices mécanisme + CTA\n  Structure répliquée depuis tryelvera.com, contenu Faja Detox de Aceite de Ricino.\n  VERSION FINALE — icônes Shopify + bouton fonctionnel.\n  À coller dans une section « Liquid personnalisé ».\n{%- endcomment -%}\n\n{%- liquid\n  # ---------- RÉGLAGES ----------\n\n  assign titulo_1 = \"Una fórmula de aceite de ricino para tu intestino\"\n  assign titulo_2 = \"Recupera el ritmo natural de tu cuerpo\"\n\n  assign badge_1 = \"Prensado en frío, sin hexano\"\n  assign badge_2 = \"Sin cápsulas, sin sabor\"\n  assign badge_3 = \"Reutilizable durante meses\"\n\n  assign ben_1_icono  = \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/0a71a054-34d7-419c-9fda-acf12d205b77_430x.svg?v=1785283542\"\n  assign ben_1_titulo = \"Rompe la barrera del biofilm\"\n  assign ben_1_texto  = \"El ácido ricinoleico —el 90 % del aceite— es una de las pocas sustancias naturales capaces de disolver el escudo que protege lo que se esconde en tu intestino.\"\n\n  assign ben_2_icono  = \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/blood_13858030_1_1_430x.png?v=1785283542\"\n  assign ben_2_titulo = \"Llega donde las cápsulas no llegan\"\n  assign ben_2_texto  = \"La absorción transdérmica evita el ácido del estómago y lleva el principio activo directo al tejido, en concentración completa.\"\n\n  assign ben_3_icono  = \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/290d6a4c-fc0f-4ef3-b5ed-fbde3c2480ff_430x.svg?v=1785283542\"\n  assign ben_3_titulo = \"Actúa 8 horas seguidas, cada noche\"\n  assign ben_3_texto  = \"La compresión constante mantiene el contacto mientras duermes, justo en la franja en la que tu sistema digestivo hace su trabajo.\"\n\n  assign ben_4_icono  = \"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/ds_430x.webp?v=1785283542\"\n  assign ben_4_titulo = \"Desinflama y desbloquea\"\n  assign ben_4_texto  = \"Reduce la hinchazón y la retención, y devuelve la regularidad sin laxantes ni purgas agresivas.\"\n\n  assign cta_texto   = \"Pruébala sin riesgo\"\n  assign cta_linea_1 = \"Envío gratis incluido\"\n  assign cta_linea_2 = \"Garantía de 90 días\"\n\n  # ---------- FIN DES RÉGLAGES ----------\n-%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"elorya-formula\">\n\n  <header class=\"elorya-formula__head\">\n    <h2 class=\"elorya-formula__t1\">{{ titulo_1 }}</h2>\n    <h2 class=\"elorya-formula__t2\">{{ titulo_2 }}</h2>\n\n    <ul class=\"elorya-formula__badges\">\n      <li>{{ badge_1 }}</li>\n      <li>{{ badge_2 }}</li>\n      <li>{{ badge_3 }}</li>\n    </ul>\n  </header>\n\n  <ul class=\"elorya-formula__list\">\n\n    <li class=\"elorya-formula__item\">\n      <span class=\"elorya-formula__ico\">\n        <img src=\"{{ ben_1_icono }}\" alt=\"\" width=\"26\" height=\"26\" loading=\"lazy\">\n      </span>\n      <div class=\"elorya-formula__body\">\n        <p class=\"elorya-formula__title\">{{ ben_1_titulo }}</p>\n        <p class=\"elorya-formula__text\">{{ ben_1_texto }}</p>\n      </div>\n    </li>\n\n    <li class=\"elorya-formula__item\">\n      <span class=\"elorya-formula__ico\">\n        <img src=\"{{ ben_2_icono }}\" alt=\"\" width=\"26\" height=\"26\" loading=\"lazy\">\n      </span>\n      <div class=\"elorya-formula__body\">\n        <p class=\"elorya-formula__title\">{{ ben_2_titulo }}</p>\n        <p class=\"elorya-formula__text\">{{ ben_2_texto }}</p>\n      </div>\n    </li>\n\n    <li class=\"elorya-formula__item\">\n      <span class=\"elorya-formula__ico\">\n        <img src=\"{{ ben_3_icono }}\" alt=\"\" width=\"26\" height=\"26\" loading=\"lazy\">\n      </span>\n      <div class=\"elorya-formula__body\">\n        <p class=\"elorya-formula__title\">{{ ben_3_titulo }}</p>\n        <p class=\"elorya-formula__text\">{{ ben_3_texto }}</p>\n      </div>\n    </li>\n\n    <li class=\"elorya-formula__item\">\n      <span class=\"elorya-formula__ico\">\n        <img src=\"{{ ben_4_icono }}\" alt=\"\" width=\"26\" height=\"26\" loading=\"lazy\">\n      </span>\n      <div class=\"elorya-formula__body\">\n        <p class=\"elorya-formula__title\">{{ ben_4_titulo }}</p>\n        <p class=\"elorya-formula__text\">{{ ben_4_texto }}</p>\n      </div>\n    </li>\n\n  </ul>\n\n  <div class=\"elorya-formula__cta\">\n    <button type=\"button\" class=\"elorya-formula__btn\" data-elorya-scroll>{{ cta_texto }}</button>\n    <ul class=\"elorya-formula__reassure\">\n      <li>{{ cta_linea_1 }}</li>\n      <li>{{ cta_linea_2 }}</li>\n    </ul>\n  </div>\n\n</section>\n\n<style>\n  .elorya-formula {\n    --e-green: #2C4A35;\n    --e-title: #14140F;\n    --e-body: #4A4A44;\n    --e-line: #E6E4DE;\n    --e-bg: #FAF9F6;\n    --e-font: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;\n\n    box-sizing: border-box;\n    width: 100%;\n    max-width: 720px;\n    margin: 26px auto;\n    padding: 30px 28px 26px;\n    background: var(--e-bg);\n    border-radius: 14px;\n    font-family: var(--e-font);\n  }\n  .elorya-formula *,\n  .elorya-formula *::before,\n  .elorya-formula *::after { box-sizing: border-box; }\n\n  /* ── Titres ── */\n  .elorya-formula__head { text-align: center; margin-bottom: 26px; }\n\n  .elorya-formula__t1,\n  .elorya-formula__t2 {\n    font-family: var(--e-font);\n    color: var(--e-title);\n    margin: 0;\n    letter-spacing: -0.2px;\n  }\n  .elorya-formula__t1 {\n    font-size: 19px;\n    font-weight: 600;\n    line-height: 1.32;\n  }\n  .elorya-formula__t2 {\n    font-size: 21px;\n    font-weight: 800;\n    line-height: 1.28;\n    margin-top: 5px;\n  }\n\n  /* ── Micro-badges ── */\n  .elorya-formula__badges {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 7px 8px;\n    list-style: none;\n    margin: 16px 0 0;\n    padding: 0;\n  }\n  .elorya-formula__badges li {\n    font-size: 10.5px;\n    font-weight: 600;\n    letter-spacing: 0.4px;\n    text-transform: uppercase;\n    color: var(--e-green);\n    background: #FFFFFF;\n    border: 1px solid var(--e-line);\n    border-radius: 100px;\n    padding: 6px 12px;\n    line-height: 1.2;\n  }\n\n  /* ── Bénéfices ── */\n  .elorya-formula__list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n  .elorya-formula__item {\n    display: flex;\n    align-items: flex-start;\n    gap: 16px;\n    padding: 18px 0;\n    border-bottom: 1px solid var(--e-line);\n    list-style: none;\n  }\n  .elorya-formula__item:last-child { border-bottom: none; padding-bottom: 6px; }\n\n  .elorya-formula__ico {\n    flex: 0 0 40px;\n    width: 40px;\n    height: 40px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #FFFFFF;\n    border: 1px solid var(--e-line);\n    border-radius: 10px;\n    margin-top: 1px;\n    overflow: hidden;\n  }\n  .elorya-formula__ico img {\n    width: 26px;\n    height: 26px;\n    object-fit: contain;\n    display: block;\n  }\n\n  .elorya-formula__body { flex: 1; min-width: 0; }\n\n  .elorya-formula__title {\n    font-family: var(--e-font);\n    font-size: 14.5px;\n    font-weight: 700;\n    line-height: 1.35;\n    color: var(--e-title);\n    margin: 0 0 5px;\n  }\n  .elorya-formula__text {\n    font-family: var(--e-font);\n    font-size: 13px;\n    font-weight: 400;\n    line-height: 1.62;\n    color: var(--e-body);\n    margin: 0;\n  }\n\n  /* ── CTA ── */\n  .elorya-formula__cta { margin-top: 24px; text-align: center; }\n\n  .elorya-formula__btn {\n    display: block;\n    width: 100%;\n    padding: 15px 22px;\n    background: var(--e-green);\n    color: #FFFFFF;\n    font-family: var(--e-font);\n    font-size: 14.5px;\n    font-weight: 700;\n    letter-spacing: 0.2px;\n    text-align: center;\n    border: none;\n    border-radius: 100px;\n    cursor: pointer;\n    -webkit-appearance: none;\n    appearance: none;\n    transition: opacity 0.2s ease, transform 0.15s ease;\n  }\n  .elorya-formula__btn:hover { opacity: 0.9; }\n  .elorya-formula__btn:active { transform: scale(0.99); }\n\n  .elorya-formula__reassure {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 6px 20px;\n    list-style: none;\n    margin: 13px 0 0;\n    padding: 0;\n  }\n  .elorya-formula__reassure li {\n    position: relative;\n    padding-left: 17px;\n    font-size: 11.5px;\n    font-weight: 500;\n    color: var(--e-body);\n    line-height: 1.3;\n    list-style: none;\n  }\n  .elorya-formula__reassure li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: 50%;\n    width: 11px;\n    height: 6px;\n    margin-top: -4px;\n    border-left: 1.8px solid var(--e-green);\n    border-bottom: 1.8px solid var(--e-green);\n    transform: rotate(-45deg);\n  }\n\n  /* ── Mobile ── */\n  @media (max-width: 749px) {\n    .elorya-formula {\n      margin: 20px auto;\n      padding: 24px 18px 20px;\n      border-radius: 12px;\n    }\n    .elorya-formula__head { margin-bottom: 20px; }\n    .elorya-formula__t1 { font-size: 16.5px; }\n    .elorya-formula__t2 { font-size: 18px; }\n    .elorya-formula__badges { gap: 6px; margin-top: 13px; }\n    .elorya-formula__badges li { font-size: 9.5px; padding: 5px 10px; }\n\n    .elorya-formula__item { gap: 13px; padding: 15px 0; }\n    .elorya-formula__ico { flex: 0 0 34px; width: 34px; height: 34px; border-radius: 9px; }\n    .elorya-formula__ico img { width: 22px; height: 22px; }\n    .elorya-formula__title { font-size: 13.5px; }\n    .elorya-formula__text { font-size: 12.5px; line-height: 1.58; }\n\n    .elorya-formula__btn { font-size: 13.5px; padding: 14px 20px; }\n    .elorya-formula__reassure li { font-size: 11px; }\n  }\n</style>\n\n<script>\n(function(){\n  var SELECTORS = [\n    'form[action*=\"/cart/add\"]',\n    'product-form',\n    '.product-form',\n    '[name=\"add\"]',\n    '.shopify-payment-button',\n    '.product__info-wrapper',\n    '#MainContent'\n  ];\n\n  function findTarget(){\n    for (var i = 0; i < SELECTORS.length; i++) {\n      var el = document.querySelector(SELECTORS[i]);\n      if (el) return el;\n    }\n    return null;\n  }\n\n  document.querySelectorAll('[data-elorya-scroll]').forEach(function(btn){\n    btn.addEventListener('click', function(){\n      var target = findTarget();\n      if (!target) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }\n      var y = target.getBoundingClientRect().top + window.pageYOffset - 90;\n      window.scrollTo({ top: y, behavior: 'smooth' });\n    });\n  });\n})();\n</script>",
