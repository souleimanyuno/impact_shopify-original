 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z\"/><line x1=\"7\" y1=\"7\" x2=\"7.01\" y2=\"7\"/></svg>\n      Nothing Touches Your Stomach\n    </span>\n\n    <span class=\"ticker-item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\" rx=\"2\"/><path d=\"M16 8h4l3 5v3h-7V8z\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg>\n      Free Exchanges on Every Order\n    </span>\n\n    <span class=\"ticker-item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z\"/><line x1=\"7\" y1=\"7\" x2=\"7.01\" y2=\"7\"/></svg>\n      Not See-Through — We Tested It\n    </span>\n\n    <span class=\"ticker-item\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\" rx=\"2\"/><path d=\"M16 8h4l3 5v3h-7V8z\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg>\n      4,300+ Women Never Went Back\n    </span>\n\n  </div>\n</div>\n\n<style>\n.ticker-wrap {\n  width: 100%;\n  overflow: hidden;\n  background: #dbdbdb;\n  padding: 16px 0;\n  border-top: 1px solid #2e2e2e;\n  border-bottom: 1px solid #2e2e2e;\n}\n.ticker-track {\n  display: flex;\n  width: max-content;\n  animation: ticker-scroll 28s linear infinite;\n}\n.ticker-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: #C4614A;\n  font-size: 18px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.07em;\n  white-space: nowrap;\n  padding: 0 28px;\n}\n.ticker-item svg {\n  color: #C4614A;\n  flex-shrink: 0;\n}\n@keyframes ticker-scroll {\n  0%   { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n@media (max-width: 480px) {\n  .ticker-item {\n    font-size: 10px;\n    padding: 0 20px;\n    gap: 5px;\n  }\n  .ticker-item svg {\n    width: 12px;\n    height: 12px;\n  }\n}\n</style>",
