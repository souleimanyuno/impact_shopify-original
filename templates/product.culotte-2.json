        "liquid_tWPHgD": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}\n  ELORYA — Puces réassurance + bouton \"Guía de tallas\" + modale tableau\n{%- endcomment -%}\n\n<style>\n  .elo-size{\n    --elo-text:var(--elorya-text,#14140F);\n    --elo-body:var(--elorya-body,#3A3A34);\n    --elo-line:var(--elorya-line,#E6E6E2);\n    --elo-cream:var(--elorya-notice-bg,#FCF2E3);\n    --elo-brown:#4A3524;\n    font-family:var(--elorya-font,'Montserrat',-apple-system,BlinkMacSystemFont,sans-serif);\n    color:var(--elo-body);margin:16px 0;\n  }\n  .elo-size *{box-sizing:border-box}\n\n  /* ---------- Puces ---------- */\n  .elo-size__pills{\n    background:var(--elo-cream);border-radius:14px;\n    padding:13px 14px;display:flex;flex-direction:column;gap:14px;\n  }\n  .elo-size__pill{display:flex;align-items:flex-start;gap:10px}\n  .elo-size__check{\n    flex-shrink:0;width:22px;height:22px;border-radius:6px;\n    background:var(--elo-brown);display:flex;align-items:center;justify-content:center;\n  }\n  .elo-size__check svg{width:12px;height:12px;stroke:#fff;fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}\n  .elo-size__pill span{font-size:13px;line-height:1.4;font-weight:700;color:var(--elo-brown);padding-top:2px}\n\n  /* ---------- Bouton ---------- */\n  .elo-size__btnwrap{display:flex;justify-content:center;margin-top:12px}\n  .elo-size__btn{\n    appearance:none;border:0;cursor:pointer;\n    background:var(--elo-cream);color:var(--elo-brown);\n    font-family:inherit;font-size:13px;font-weight:700;letter-spacing:-.01em;\n    padding:11px 22px;border-radius:999px;\n    animation:elo-bounce 2.2s ease-in-out infinite;\n    transition:background .2s ease;\n  }\n  .elo-size__btn:hover{background:#F5E9D8;animation-play-state:paused}\n  @keyframes elo-bounce{\n    0%,72%,100%{transform:translateY(0)}\n    80%{transform:translateY(-5px)}\n    88%{transform:translateY(-2px)}\n  }\n  @media (prefers-reduced-motion:reduce){.elo-size__btn{animation:none}}\n\n  /* ---------- Modale ---------- */\n  .elo-modal{\n    position:fixed;inset:0;z-index:100000;\n    display:none;align-items:center;justify-content:center;padding:16px;\n    font-family:var(--elorya-font,'Montserrat',sans-serif);\n  }\n  .elo-modal.is-open{display:flex}\n  .elo-modal__bg{position:absolute;inset:0;background:rgba(20,20,15,.55);animation:elo-fade .2s ease}\n  .elo-modal__box{\n    position:relative;background:#fff;border-radius:18px;overflow:hidden;\n    width:100%;max-width:420px;max-height:88vh;overflow-y:auto;\n    box-shadow:0 20px 60px rgba(0,0,0,.25);animation:elo-pop .22s ease;\n    -webkit-overflow-scrolling:touch;\n  }\n  @keyframes elo-fade{from{opacity:0}to{opacity:1}}\n  @keyframes elo-pop{from{opacity:0;transform:translateY(14px) scale(.98)}to{opacity:1;transform:none}}\n\n  .elo-modal__head{background:var(--elo-cream);padding:20px 44px 16px;text-align:center}\n  .elo-modal__title{font-size:17px;font-weight:800;color:var(--elo-brown);margin:0 0 5px;letter-spacing:-.01em}\n  .elo-modal__sub{font-size:12px;line-height:1.4;color:var(--elo-body);margin:0;opacity:.85}\n  .elo-modal__close{\n    position:absolute;top:12px;right:12px;width:32px;height:32px;\n    border:0;background:transparent;cursor:pointer;padding:0;\n    display:flex;align-items:center;justify-content:center;border-radius:8px;\n  }\n  .elo-modal__close svg{width:18px;height:18px;stroke:var(--elo-brown);fill:none;stroke-width:2.2;stroke-linecap:round}\n  .elo-modal__close:hover{background:rgba(0,0,0,.06)}\n\n  .elo-modal__body{padding:16px 16px 18px}\n  .elo-tbl{width:100%;border-collapse:collapse;font-size:13px}\n  .elo-tbl thead th{\n    background:#F0E5D6;color:var(--elo-brown);\n    font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;\n    padding:11px 8px;text-align:center;\n  }\n  .elo-tbl thead th:first-child{text-align:left;padding-left:12px;border-radius:8px 0 0 8px}\n  .elo-tbl thead th:last-child{border-radius:0 8px 8px 0}\n  .elo-tbl tbody td{\n    padding:12px 8px;text-align:center;border-bottom:1px solid var(--elo-line);\n    color:var(--elo-body);white-space:nowrap;\n  }\n  .elo-tbl tbody td:first-child{text-align:left;padding-left:12px;font-weight:800;color:var(--elo-text);font-size:14px}\n  .elo-tbl tbody tr:last-child td{border-bottom:0}\n\n  .elo-tip{\n    margin-top:14px;background:var(--elo-cream);border:1px solid #EFE2CE;\n    border-radius:12px;padding:12px 13px;display:flex;gap:9px;align-items:flex-start;\n  }\n  .elo-tip__ico{font-size:14px;line-height:1.5;flex-shrink:0}\n  .elo-tip p{margin:0;font-size:12.5px;line-height:1.55;color:var(--elo-body)}\n  .elo-tip b{font-weight:700;color:var(--elo-text)}\n\n  /* ---------- Desktop ---------- */\n  @media (min-width:750px){\n    .elo-size__pills{padding:16px 18px;gap:11px}\n    .elo-size__check{width:24px;height:24px}\n    .elo-size__pill span{font-size:14.5px}\n    .elo-size__btn{font-size:14px;padding:12px 26px}\n    .elo-modal__box{max-width:480px}\n    .elo-modal__title{font-size:19px}\n    .elo-modal__sub{font-size:13px}\n    .elo-modal__body{padding:18px 20px 22px}\n    .elo-tbl{font-size:14px}\n    .elo-tbl thead th{font-size:11px}\n    .elo-tip p{font-size:13px}\n  }\n</style>\n\n<div class=\"elo-size\">\n\n  <div class=\"elo-size__pills\">\n    <div class=\"elo-size__pill\">\n      <span class=\"elo-size__check\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n      <span>Pide tu talla de siempre</span>\n    </div>\n    <div class=\"elo-size__pill\">\n      <span class=\"elo-size__check\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n      <span>Funciona incluso años después del parto</span>\n    </div>\n  </div>\n\n  <div class=\"elo-size__btnwrap\">\n    <button type=\"button\" class=\"elo-size__btn\" data-elo-open>Guía de tallas ›</button>\n  </div>\n\n</div>\n\n<div class=\"elo-modal\" id=\"elo-size-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"elo-size-title\">\n  <div class=\"elo-modal__bg\" data-elo-close></div>\n  <div class=\"elo-modal__box\">\n\n    <div class=\"elo-modal__head\">\n      <button type=\"button\" class=\"elo-modal__close\" data-elo-close aria-label=\"Cerrar\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n      </button>\n      <h3 class=\"elo-modal__title\" id=\"elo-size-title\">Guía de Tallas</h3>\n      <p class=\"elo-modal__sub\">Braguita Moldeadora Post-Parto Compresión 360°</p>\n    </div>\n\n    <div class=\"elo-modal__body\">\n      <table class=\"elo-tbl\">\n        <thead>\n          <tr><th>Elorya</th><th>Contorno de cintura</th><th>Talla ES</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>S</td><td>62 – 68 cm</td><td>34 – 36</td></tr>\n          <tr><td>M</td><td>68 – 76 cm</td><td>38 – 40</td></tr>\n          <tr><td>L</td><td>76 – 82 cm</td><td>40 – 42</td></tr>\n          <tr><td>XL</td><td>82 – 90 cm</td><td>44 – 46</td></tr>\n          <tr><td>2XL</td><td>88 – 100 cm</td><td>48 – 50</td></tr>\n          <tr><td>3XL</td><td>92 – 112 cm</td><td>50 – 52+</td></tr>\n        </tbody>\n      </table>\n\n      <div class=\"elo-tip\">\n        <span class=\"elo-tip__ico\">💡</span>\n        <p>¿Estás entre dos tallas? Coge la <b>más pequeña</b> para una <b>sujeción óptima</b>. Nuestro tejido mesh se adapta a tu cuerpo con suavidad.</p>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function(){\n  var modal = document.getElementById('elo-size-modal');\n  if(!modal) return;\n  if(modal.parentNode !== document.body) document.body.appendChild(modal);\n\n  var scrollY = 0;\n  function open(){\n    scrollY = window.scrollY;\n    modal.classList.add('is-open');\n    document.body.style.cssText = 'position:fixed;top:-'+scrollY+'px;left:0;right:0;overflow:hidden';\n    var c = modal.querySelector('.elo-modal__close'); if(c) c.focus();\n  }\n  function close(){\n    modal.classList.remove('is-open');\n    document.body.style.cssText = '';\n    window.scrollTo(0, scrollY);\n  }\n  document.addEventListener('click', function(e){\n    if(e.target.closest('[data-elo-open]')){ e.preventDefault(); open(); }\n    else if(e.target.closest('[data-elo-close]')){ e.preventDefault(); close(); }\n  });\n  document.addEventListener('keydown', function(e){\n    if(e.key === 'Escape' && modal.classList.contains('is-open')) close();\n  });\n})();\n</script>"
          }
        },
