        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": false,
        "liquid": "{%- comment -%}\n  ELORYA — \"¿Te suena?\" — problèmes / pourquoi ça n'a pas marché / solution\n  À placer AVANT la FAQ et avant les blocs de preuve.\n{%- endcomment -%}\n\n<style>\n  .elo-why{\n    --elo-text:var(--elorya-text,#14140F);\n    --elo-body:var(--elorya-body,#3A3A34);\n    --elo-line:var(--elorya-line,#E6E6E2);\n    --elo-cream:var(--elorya-notice-bg,#FCF2E3);\n    --elo-green:var(--elorya-green,#2C4A35);\n    --elo-red:#B0554A;\n    font-family:var(--elorya-font,'Montserrat',-apple-system,BlinkMacSystemFont,sans-serif);\n    color:var(--elo-body);margin:26px 0;\n  }\n  .elo-why *{box-sizing:border-box}\n\n  .elo-why__head{text-align:center;margin:0 0 14px;padding:0 4px}\n  .elo-why__title{font-size:20px;line-height:1.3;font-weight:800;letter-spacing:-.015em;color:var(--elo-text);margin:0 0 5px}\n  .elo-why__sub{font-size:12.5px;line-height:1.5;margin:0;opacity:.9}\n\n  .elo-why__list{display:flex;flex-direction:column;gap:8px}\n\n  .elo-why__item{\n    border:1px solid var(--elo-line);border-radius:12px;\n    background:#fff;overflow:hidden;transition:border-color .2s ease;\n  }\n  .elo-why__item[open]{border-color:#D9D2C4;background:var(--elo-cream)}\n\n  .elo-why__q{\n    list-style:none;cursor:pointer;\n    display:flex;align-items:center;gap:10px;padding:13px 13px;\n  }\n  .elo-why__q::-webkit-details-marker{display:none}\n  .elo-why__label{\n    flex:1;font-size:12.5px;line-height:1.4;font-weight:700;\n    color:var(--elo-text);letter-spacing:-.01em;\n  }\n  .elo-why__chev{flex-shrink:0;transition:transform .25s ease}\n  .elo-why__chev svg{width:15px;height:15px;stroke:#9A9A94;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;display:block}\n  .elo-why__item[open] .elo-why__chev{transform:rotate(180deg)}\n\n  .elo-why__a{padding:0 13px 13px;animation:elo-why-in .22s ease}\n  @keyframes elo-why-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}\n\n  .elo-why__row{display:flex;gap:9px;align-items:flex-start}\n  .elo-why__row + .elo-why__row{margin-top:10px;padding-top:10px;border-top:1px solid rgba(0,0,0,.07)}\n  .elo-why__ico{\n    flex-shrink:0;width:18px;height:18px;border-radius:50%;\n    display:flex;align-items:center;justify-content:center;margin-top:1px;\n  }\n  .elo-why__ico--x{background:rgba(176,85,74,.12)}\n  .elo-why__ico--v{background:rgba(44,74,53,.12)}\n  .elo-why__ico svg{width:10px;height:10px;fill:none;stroke-width:2.8;stroke-linecap:round;stroke-linejoin:round}\n  .elo-why__ico--x svg{stroke:var(--elo-red)}\n  .elo-why__ico--v svg{stroke:var(--elo-green)}\n\n  .elo-why__k{\n    display:block;font-size:10px;font-weight:800;letter-spacing:.06em;\n    text-transform:uppercase;margin-bottom:2px;\n  }\n  .elo-why__row--x .elo-why__k{color:var(--elo-red)}\n  .elo-why__row--v .elo-why__k{color:var(--elo-green)}\n  .elo-why__txt{font-size:12px;line-height:1.55;margin:0}\n  .elo-why__txt b{font-weight:700;color:var(--elo-text)}\n\n  .elo-why__foot{\n    margin-top:12px;text-align:center;font-size:12px;line-height:1.55;\n    font-weight:700;color:var(--elo-text);padding:0 8px;\n  }\n\n  @media (min-width:750px){\n    .elo-why__title{font-size:20px}\n    .elo-why__sub{font-size:13.5px}\n    .elo-why__q{padding:15px 16px}\n    .elo-why__label{font-size:14px}\n    .elo-why__a{padding:0 16px 15px}\n    .elo-why__txt{font-size:13px}\n    .elo-why__foot{font-size:13.5px}\n  }\n</style>\n\n<div class=\"elo-why\" id=\"elo-why\">\n\n  <div class=\"elo-why__head\">\n    <h3 class=\"elo-why__title\">«Lo he probado todo y nada funciona»</h3>\n    <p class=\"elo-why__sub\">Si te reconoces en alguna de estas frases, hay una explicación. Y no es la que te han contado.</p>\n  </div>\n\n  <div class=\"elo-why__list\">\n\n    <details class=\"elo-why__item\">\n      <summary class=\"elo-why__q\">\n        <span class=\"elo-why__label\">«He perdido todos los kilos y la tripa sigue ahí»</span>\n        <span class=\"elo-why__chev\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></span>\n      </summary>\n      <div class=\"elo-why__a\">\n        <div class=\"elo-why__row elo-why__row--x\">\n          <span class=\"elo-why__ico elo-why__ico--x\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></span>\n          <div><span class=\"elo-why__k\">Por qué no funcionó</span>\n          <p class=\"elo-why__txt\">Porque <b>no es grasa</b>. Es la pared abdominal, que se quedó abierta. No se quema una estructura desplazada con un déficit de calorías.</p></div>\n        </div>\n        <div class=\"elo-why__row elo-why__row--v\">\n          <span class=\"elo-why__ico elo-why__ico--v\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n          <div><span class=\"elo-why__k\">Lo que hace Elorya</span>\n          <p class=\"elo-why__txt\">Actúa sobre la <b>pared</b>, no sobre la grasa. Compresión circular que ayuda a que todo vuelva a su sitio.</p></div>\n        </div>\n      </div>\n    </details>\n\n    <details class=\"elo-why__item\">\n      <summary class=\"elo-why__q\">\n        <span class=\"elo-why__label\">«Hago abdominales cada semana y no cambia nada»</span>\n        <span class=\"elo-why__chev\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></span>\n      </summary>\n      <div class=\"elo-why__a\">\n        <div class=\"elo-why__row elo-why__row--x\">\n          <span class=\"elo-why__ico elo-why__ico--x\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></span>\n          <div><span class=\"elo-why__k\">Por qué no funcionó</span>\n          <p class=\"elo-why__txt\">Los abdominales <b>refuerzan el músculo, pero no cierran una pared separada</b>. A veces incluso la empujan más hacia fuera.</p></div>\n        </div>\n        <div class=\"elo-why__row elo-why__row--v\">\n          <span class=\"elo-why__ico elo-why__ico--v\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n          <div><span class=\"elo-why__k\">Lo que hace Elorya</span>\n          <p class=\"elo-why__txt\">No musculas: <b>sostienes</b>. La compresión 360° acompaña la pared hacia dentro en lugar de tensarla hacia fuera.</p></div>\n        </div>\n      </div>\n    </details>\n\n    <details class=\"elo-why__item\">\n      <summary class=\"elo-why__q\">\n        <span class=\"elo-why__label\">«Ya he probado fajas: se enrollan, se bajan y aprietan»</span>\n        <span class=\"elo-why__chev\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></span>\n      </summary>\n      <div class=\"elo-why__a\">\n        <div class=\"elo-why__row elo-why__row--x\">\n          <span class=\"elo-why__ico elo-why__ico--x\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></span>\n          <div><span class=\"elo-why__k\">Por qué no funcionó</span>\n          <p class=\"elo-why__txt\">Porque <b>solo comprimen por delante</b> y no tienen dónde agarrarse. Por eso ruedan, se bajan y no aguantas más de dos horas.</p></div>\n        </div>\n        <div class=\"elo-why__row elo-why__row--v\">\n          <span class=\"elo-why__ico elo-why__ico--v\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n          <div><span class=\"elo-why__k\">Lo que hace Elorya</span>\n          <p class=\"elo-why__txt\"><b>Las fajas comprimen por delante. Tu cuerpo da toda la vuelta.</b> Elorya se apoya en toda la circunferencia: es una braguita, no una banda.</p></div>\n        </div>\n      </div>\n    </details>\n\n    <details class=\"elo-why__item\">\n      <summary class=\"elo-why__q\">\n        <span class=\"elo-why__label\">«Hice la recuperación con la fisio y la tripa no se movió»</span>\n        <span class=\"elo-why__chev\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></span>\n      </summary>\n      <div class=\"elo-why__a\">\n        <div class=\"elo-why__row elo-why__row--x\">\n          <span class=\"elo-why__ico elo-why__ico--x\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></span>\n          <div><span class=\"elo-why__k\">Por qué no funcionó</span>\n          <p class=\"elo-why__txt\">Hiciste lo correcto, pero en <b>otra zona</b>. La recuperación trabaja el <b>suelo pélvico</b>, no el cierre de la pared abdominal de delante.</p></div>\n        </div>\n        <div class=\"elo-why__row elo-why__row--v\">\n          <span class=\"elo-why__ico elo-why__ico--v\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n          <div><span class=\"elo-why__k\">Lo que hace Elorya</span>\n          <p class=\"elo-why__txt\">Cubre justo lo que falta. <b>No sustituye tu recuperación, la acompaña</b> — sigue con tu fisio.</p></div>\n        </div>\n      </div>\n    </details>\n\n    <details class=\"elo-why__item\">\n      <summary class=\"elo-why__q\">\n        <span class=\"elo-why__label\">«Tuve cesárea y me ha quedado un delantal encima de la cicatriz»</span>\n        <span class=\"elo-why__chev\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></span>\n      </summary>\n      <div class=\"elo-why__a\">\n        <div class=\"elo-why__row elo-why__row--x\">\n          <span class=\"elo-why__ico elo-why__ico--x\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></span>\n          <div><span class=\"elo-why__k\">Por qué no funcionó</span>\n          <p class=\"elo-why__txt\">La cicatriz <b>se adhiere a los tejidos</b> y tira de la piel hacia abajo. No es grasa ni falta de voluntad: es puramente mecánico.</p></div>\n        </div>\n        <div class=\"elo-why__row elo-why__row--v\">\n          <span class=\"elo-why__ico elo-why__ico--v\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n          <div><span class=\"elo-why__k\">Lo que hace Elorya</span>\n          <p class=\"elo-why__txt\">El <b>corte alto</b> pasa por encima de la cicatriz, sin apoyarse en ella, y sostiene toda la zona. A partir de las 6 semanas.</p></div>\n        </div>\n      </div>\n    </details>\n\n    <details class=\"elo-why__item\">\n      <summary class=\"elo-why__q\">\n        <span class=\"elo-why__label\">«Di a luz hace años. Creo que ya es tarde para mí»</span>\n        <span class=\"elo-why__chev\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\"/></svg></span>\n      </summary>\n      <div class=\"elo-why__a\">\n        <div class=\"elo-why__row elo-why__row--x\">\n          <span class=\"elo-why__ico elo-why__ico--x\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></span>\n          <div><span class=\"elo-why__k\">Por qué lo creías</span>\n          <p class=\"elo-why__txt\">Porque nadie te explicó nunca qué pasaba de verdad. Así que asumiste que era definitivo.</p></div>\n        </div>\n        <div class=\"elo-why__row elo-why__row--v\">\n          <span class=\"elo-why__ico elo-why__ico--v\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg></span>\n          <div><span class=\"elo-why__k\">Lo que hace Elorya</span>\n          <p class=\"elo-why__txt\"><b>La pared abdominal no caduca.</b> 3 meses o 10 años después, sigue siendo mecánico. Y lo mecánico se puede sostener.</p></div>\n        </div>\n      </div>\n    </details>\n\n  </div>\n\n  <p class=\"elo-why__foot\">No es culpa tuya. No es falta de voluntad. Es mecánico y por eso tiene solución.</p>\n\n</div>\n\n<script>\n(function(){\n  var box = document.getElementById('elo-why');\n  if(!box) return;\n  var items = box.querySelectorAll('details.elo-why__item');\n  items.forEach(function(d){\n    d.addEventListener('toggle', function(){\n      if(!d.open) return;\n      items.forEach(function(o){ if(o !== d) o.open = false; });\n    });\n  });\n})();\n</script>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_TNiQNU": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ELORYA — \"Por qué es diferente\" : image comparative + 2 colonnes + encadré bengkung\n  À placer juste après le bloc \"¿Te suena?\"\n{%- endcomment -%}\n\n<style>\n  .elo-diff{\n    --elo-text:var(--elorya-text,#14140F);\n    --elo-body:var(--elorya-body,#3A3A34);\n    --elo-line:var(--elorya-line,#E6E6E2);\n    --elo-cream:var(--elorya-notice-bg,#FCF2E3);\n    --elo-green:var(--elorya-green,#2C4A35);\n    --elo-red:#B0554A;\n    --elo-brown:#4A3524;\n    font-family:var(--elorya-font,'Montserrat',-apple-system,BlinkMacSystemFont,sans-serif);\n    color:var(--elo-body);margin:30px 0;\n  }\n  .elo-diff *{box-sizing:border-box}\n\n  /* ---------- En-tête ---------- */\n  .elo-diff__eyebrow{\n    text-align:center;font-size:11px;font-weight:800;letter-spacing:.14em;\n    text-transform:uppercase;color:var(--elo-brown);opacity:.75;margin:0 0 8px;\n  }\n  .elo-diff__h{\n    text-align:center;font-size:20px;line-height:1.22;font-weight:800;\n    letter-spacing:-.02em;color:var(--elo-text);margin:0 0 8px;padding:0 4px;\n  }\n  .elo-diff__sub{\n    text-align:center;font-size:12.5px;line-height:1.5;margin:0 0 16px;\n    color:var(--elo-body);opacity:.85;padding:0 6px;\n  }\n\n  /* ---------- Image ---------- */\n  .elo-diff__img{\n    display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;\n    border-radius:14px;background:#EDEBE7;margin:0 0 14px;\n  }\n\n  /* ---------- 2 colonnes ---------- */\n  .elo-diff__cols{display:flex;flex-direction:column;gap:10px}\n  .elo-diff__col{\n    border:1px solid var(--elo-line);border-radius:14px;\n    background:#fff;padding:14px 14px;\n  }\n  .elo-diff__col--win{border:1.5px solid var(--elo-brown)}\n\n  .elo-diff__ct{\n    display:flex;align-items:center;gap:7px;margin:0 0 10px;\n    font-size:11.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;\n  }\n  .elo-diff__ct svg{width:13px;height:13px;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}\n  .elo-diff__col--lose .elo-diff__ct{color:var(--elo-red)}\n  .elo-diff__col--lose .elo-diff__ct svg{stroke:var(--elo-red)}\n  .elo-diff__col--win .elo-diff__ct{color:var(--elo-text)}\n  .elo-diff__col--win .elo-diff__ct svg{stroke:var(--elo-text)}\n\n  .elo-diff__ul{list-style:none;margin:0;padding:0}\n  .elo-diff__ul li{\n    display:flex;align-items:flex-start;gap:9px;\n    font-size:12.5px;line-height:1.45;padding:5px 0;\n  }\n  .elo-diff__ul svg{width:13px;height:13px;flex-shrink:0;margin-top:3px;fill:none;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}\n  .elo-diff__col--lose .elo-diff__ul svg{stroke:#B5B5AE}\n  .elo-diff__col--lose .elo-diff__ul li{color:#7A7A73}\n  .elo-diff__col--win .elo-diff__ul svg{stroke:var(--elo-green)}\n  .elo-diff__col--win .elo-diff__ul li{color:var(--elo-text);font-weight:600}\n\n  /* ---------- Encadré bengkung ---------- */\n  .elo-diff__note{\n    margin-top:14px;background:var(--elo-cream);border-radius:14px;\n    padding:14px 14px;display:flex;gap:11px;align-items:flex-start;\n  }\n  .elo-diff__note svg{\n    width:22px;height:22px;flex-shrink:0;margin-top:1px;\n    stroke:var(--elo-green);fill:none;stroke-width:1.6;\n    stroke-linecap:round;stroke-linejoin:round;opacity:.85;\n  }\n  .elo-diff__note p{font-size:12.5px;line-height:1.6;margin:0}\n  .elo-diff__note b{font-weight:700;color:var(--elo-text)}\n\n  /* ---------- Desktop ---------- */\n  @media (min-width:750px){\n    .elo-diff__eyebrow{font-size:11px;margin-bottom:10px}\n    .elo-diff__h{font-size:27px;margin-bottom:10px}\n    .elo-diff__sub{font-size:14px;margin-bottom:20px}\n    .elo-diff__img{border-radius:16px;margin-bottom:18px}\n    .elo-diff__cols{flex-direction:row;gap:14px}\n    .elo-diff__col{flex:1;padding:18px 18px}\n    .elo-diff__ct{font-size:12.5px;margin-bottom:12px}\n    .elo-diff__ul li{font-size:14px;padding:6px 0}\n    .elo-diff__note{padding:16px 18px;margin-top:18px}\n    .elo-diff__note p{font-size:13.5px}\n  }\n</style>\n\n<div class=\"elo-diff\">\n\n  <p class=\"elo-diff__eyebrow\">Por qué es diferente</p>\n  <h2 class=\"elo-diff__h\">Las demás comprimen por delante. Elorya envuelve todo el contorno.</h2>\n  <p class=\"elo-diff__sub\">Como hace el bengkung malayo desde hace 500 años.</p>\n\n  <img\n    class=\"elo-diff__img\"\n    src=\"https://cdn.shopify.com/s/files/1/0795/2754/3033/files/hf_20260625_151841_f778b39f-6da7-4b0a-9dce-5c0ba5cfba9c.jpg?v=1785809016\"\n    alt=\"Comparación: faja clásica de velcro que solo comprime por delante frente a la braguita Elorya con compresión circular 360°\"\n    width=\"1024\" height=\"1024\" loading=\"lazy\" decoding=\"async\">\n\n  <div class=\"elo-diff__cols\">\n\n    <div class=\"elo-diff__col elo-diff__col--lose\">\n      <p class=\"elo-diff__ct\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>\n        Faja clásica\n      </p>\n      <ul class=\"elo-diff__ul\">\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg><span>Solo comprime la parte de delante</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg><span>Se sube y se enrolla al cabo de una hora</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg><span>Se marca debajo de la ropa</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg><span>Ningún resultado duradero: todo vuelve atrás</span></li>\n      </ul>\n    </div>\n\n    <div class=\"elo-diff__col elo-diff__col--win\">\n      <p class=\"elo-diff__ct\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg>\n        Elorya\n      </p>\n      <ul class=\"elo-diff__ul\">\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg><span>360° — delante, costados y espalda</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg><span>Se pone en 10 segundos, como unas bragas</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg><span>Desaparece bajo cualquier prenda</span></li>\n        <li><svg viewBox=\"0 0 24 24\"><path d=\"M4 12.5l5.5 5.5L20 6.5\"/></svg><span>Diferencia visible a las 2-3 semanas</span></li>\n      </ul>\n    </div>\n\n  </div>\n\n  <div class=\"elo-diff__note\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M12 2.8l9 4.6-9 4.6-9-4.6 9-4.6z\"/><path d=\"M3 12.2l9 4.6 9-4.6\"/><path d=\"M3 16.6l9 4.6 9-4.6\"/></svg>\n    <p><b>Inspirada en el bengkung malayo</b> — una técnica de compresión cruzada que se usa desde hace 500 años para volver a cerrar la faja abdominal después del parto.</p>\n  </div>\n\n</div>",
