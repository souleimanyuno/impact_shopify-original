        "liquid": "{%- comment -%}\n  ELORYA — Bloc Antes / Después (vidéo autoplay, muette, lazy-load)\n{%- endcomment -%}\n\n<style>\n  .elo-ba{\n    --elo-text:var(--elorya-text,#14140F);\n    --elo-body:var(--elorya-body,#3A3A34);\n    font-family:var(--elorya-font,'Montserrat',-apple-system,BlinkMacSystemFont,sans-serif);\n    margin:30px 0;\n  }\n  .elo-ba *{box-sizing:border-box}\n\n  .elo-ba__h{\n    text-align:center;font-size:22px;line-height:1.2;font-weight:800;\n    letter-spacing:.06em;text-transform:uppercase;\n    color:var(--elo-text);margin:0 0 12px;\n  }\n\n  .elo-ba__frame{\n    position:relative;width:100%;\n    aspect-ratio:900/496;\n    border-radius:14px;overflow:hidden;background:#EDEBE7;\n  }\n  .elo-ba__frame video{\n    width:100%;height:100%;object-fit:cover;display:block;background:#EDEBE7;\n  }\n\n  .elo-ba__cap{\n    text-align:center;font-size:11px;line-height:1.5;\n    color:var(--elo-body);opacity:.75;margin:9px 0 0;padding:0 10px;\n  }\n\n  @media (min-width:750px){\n    .elo-ba__h{font-size:19px;margin-bottom:16px}\n    .elo-ba__frame{border-radius:16px}\n    .elo-ba__cap{font-size:12px;margin-top:11px}\n  }\n</style>\n\n<div class=\"elo-ba\" id=\"elo-ba\">\n\n  <h2 class=\"elo-ba__h\">Antes / Después</h2>\n\n  <div class=\"elo-ba__frame\">\n    <video\n      muted\n      loop\n      playsinline\n      webkit-playsinline\n      disablepictureinpicture\n      preload=\"none\"\n      data-src=\"https://cdn.shopify.com/videos/c/o/v/66131d18205149e59147574624377c51.mp4\"></video>\n  </div>\n\n  <p class=\"elo-ba__cap\">Efecto inmediato con la braguita puesta. Los resultados pueden variar según cada cuerpo.</p>\n\n</div>\n\n<script>\n(function(){\n  var root = document.getElementById('elo-ba');\n  if(!root) return;\n  var v = root.querySelector('video');\n  if(!v) return;\n\n  if('IntersectionObserver' in window){\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(e){\n        if(e.isIntersecting){\n          if(!v.src && v.dataset.src) v.src = v.dataset.src;\n          var p = v.play(); if(p && p.catch) p.catch(function(){});\n        } else if(!v.paused){\n          v.pause();\n        }\n      });\n    }, { rootMargin:'200px', threshold:0.25 });\n    io.observe(v);\n  } else {\n    v.src = v.dataset.src;\n    v.play().catch(function(){});\n  }\n})();\n</script>",
