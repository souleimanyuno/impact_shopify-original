    "custom_liquid_qmPDte": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ELORYA · BLOC 9 — Communauté : bandeau hashtag + marquee d'avis + CTA.\n  Défilement auto, pause dès que la cliente touche, reprise après 3 s d'inactivité.\n  Placement : nouvelle section \"Liquid personalizado\", sous le bloc 8.\n{%- endcomment -%}\n{%- assign uid = block.id | default: section.id | default: 'ely9' -%}\n\n{%- comment -%} ───────────── RÉGLAGES ───────────── {%- endcomment -%}\n{%- assign ely_eyebrow = '🍦 #EloryaVerano' -%}\n{%- assign ely_c_title = 'Tú también te lo mereces este verano' -%}\n{%- assign ely_c_sub   = 'Miles de mujeres ya disfrutan del calor sin tirantes, sin marcas y sin complicaciones.' -%}\n{%- assign ely_c_cta   = 'Quiero el mío 🤍' -%}\n{%- assign ely_speed   = 0.55 -%}   {%- comment -%} px par frame : 0.3 = lent · 0.8 = rapide {%- endcomment -%}\n{%- assign ely_resume  = 3000 -%}   {%- comment -%} ms d'inactivité avant reprise auto {%- endcomment -%}\n{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0795/2754/3033/files/' -%}\n\n<style>\n  .ely-cm{\n    --ely-cream:#F7F3EE; --ely-ink:#1A1A1A; --ely-text:#2A2422; --ely-line:#D9B88A;\n    background:var(--ely-cream);padding:64px 0 56px;overflow:hidden;\n    font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));}\n  .ely-cm *,.ely-cm *::before,.ely-cm *::after{box-sizing:border-box;}\n\n  .ely-cm__head{max-width:640px;margin:0 auto;text-align:center;padding:0 20px 40px;}\n  .ely-cm__eyebrow{display:inline-block;font-size:13px;font-weight:600;letter-spacing:.04em;\n    color:var(--ely-ink);background:#fff;border:1px solid var(--ely-line);border-radius:999px;\n    padding:6px 16px;margin-bottom:16px;}\n  .ely-cm__title{font-size:clamp(26px,4vw,38px);font-weight:800;line-height:1.15;\n    color:var(--ely-text);margin:0 0 12px;letter-spacing:-.01em;}\n  .ely-cm__sub{font-size:16px;color:#6B5C5E;margin:0;line-height:1.5;}\n\n  .ely-cm__marquee{width:100%;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;\n    -webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x;\n    mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);\n    -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);}\n  .ely-cm__marquee::-webkit-scrollbar{display:none;}\n  .ely-cm__track{display:flex;gap:20px;width:max-content;padding:4px 0;}\n\n  .ely-cm__card{flex:0 0 240px;background:#fff;border-radius:18px;overflow:hidden;\n    box-shadow:0 6px 20px rgba(58,46,48,.08);display:flex;flex-direction:column;}\n  .ely-cm__photo{width:100%;height:240px;object-fit:cover;object-position:center;display:block;background:#EEE;}\n  .ely-cm__quote{font-size:14px;line-height:1.5;color:var(--ely-text);padding:16px 16px 4px;\n    margin:0;min-height:84px;}\n  .ely-cm__name{font-size:12px;font-weight:600;color:var(--ely-ink);padding:0 16px 16px;margin-top:auto;}\n\n  .ely-cm__cta{text-align:center;margin-top:44px;}\n  .ely-cm__btn{display:inline-block;background:var(--ely-ink);color:#fff;font-weight:700;font-size:15px;\n    text-decoration:none;padding:14px 32px;border-radius:999px;\n    transition:transform .15s ease,opacity .2s ease;}\n  .ely-cm__btn:hover{opacity:.88;transform:translateY(-1px);color:#fff;}\n\n  @media(max-width:480px){\n    .ely-cm{padding:48px 0 44px;}\n    .ely-cm__card{flex:0 0 200px;}\n    .ely-cm__photo{height:200px;}\n    .ely-cm__quote{min-height:92px;}\n  }\n  @media(prefers-reduced-motion:reduce){.ely-cm__marquee{scroll-behavior:auto;}}\n</style>\n\n<section class=\"ely-cm\" id=\"ely-cm-{{ uid }}\">\n\n  <div class=\"ely-cm__head\">\n    <span class=\"ely-cm__eyebrow\">{{ ely_eyebrow }}</span>\n    <h2 class=\"ely-cm__title\">{{ ely_c_title }}</h2>\n    <p class=\"ely-cm__sub\">{{ ely_c_sub }}</p>\n  </div>\n\n  <div class=\"ely-cm__marquee\" data-ely-marquee\n       data-speed=\"{{ ely_speed }}\" data-resume=\"{{ ely_resume }}\">\n    <div class=\"ely-cm__track\" data-ely-track>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}hf_20260626_141411_c83b5703-fe60-439a-8387-46b12089f206_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Con vaqueros y nada más encima. Levanta muchísimo y no se mueve ni un poco.\"</p>\n        <span class=\"ely-cm__name\">— Lucía, Madrid</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}10002_2_f4329c3b-f5c7-4765-9c25-ed7b1cf094c8_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Uso una 100D y pensaba que no me aguantaría. Es el primero que sujeta de verdad.\"</p>\n        <span class=\"ely-cm__name\">— Rocío, Sevilla</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}TYcCHachk3_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Lo estrené con un vestido palabra de honor en una boda. Diez horas y ni un susto.\"</p>\n        <span class=\"ely-cm__name\">— Cristina, Granada</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}r8hJfKpyAJ_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Con camiseta blanca no se ve absolutamente nada. Cero costuras, cero marcas.\"</p>\n        <span class=\"ely-cm__name\">— Carla, Barcelona</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}WX20240517-225200_2x_dea144dd-819b-4218-8939-18ca4cdcdd50_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Copa grande y por fin algo que no se me clava ni se me baja a media tarde.\"</p>\n        <span class=\"ely-cm__name\">— Marta, Valencia</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}hf_20260626_140706_62a5f7f1-a506-467e-bb1e-a6d8b8b08ecd_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"En casa ni me acuerdo de que lo llevo. Como no llevar nada, pero sujetando.\"</p>\n        <span class=\"ely-cm__name\">— Noelia, Alicante</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}hf_20260626_140859_219130cf-4862-4f40-8d24-89b10f98b80f_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Me lo pongo por la mañana y me olvido hasta la noche. Ni un solo ajuste.\"</p>\n        <span class=\"ely-cm__name\">— Paula, Zaragoza</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}WX20240517-224734_2x_ebad4bb2-152f-48e8-9c0c-fe7b7f2fe71f_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Debajo de escotes y chaquetas abiertas queda perfecto. Ya no me escondo.\"</p>\n        <span class=\"ely-cm__name\">— Aitana, Bilbao</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}hf_20260626_142143_43aba579-4b2b-49f1-95b1-19de9bda1d59_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Sin aros y sin marcas rojas al quitármelo. Eso para mí no tiene precio.\"</p>\n        <span class=\"ely-cm__name\">— Elena, Santander</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}a4PFna4Wiw_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Levanto los brazos, me muevo, y no tengo que recolocármelo cada dos minutos.\"</p>\n        <span class=\"ely-cm__name\">— Irene, Murcia</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}mScE6p5DzF_430x.jpg?v=1786476169\">\n        <p class=\"ely-cm__quote\">\"La tela es suavísima y se adapta al cuerpo como una segunda piel.\"</p>\n        <span class=\"ely-cm__name\">— Beatriz, Valladolid</span>\n      </article>\n\n      <article class=\"ely-cm__card\">\n        <img class=\"ely-cm__photo\" loading=\"lazy\" decoding=\"async\" alt=\"Clienta Elorya\"\n             src=\"{{ cdn }}3tJ6dkpZzT_430x.jpg?v=1786476170\">\n        <p class=\"ely-cm__quote\">\"Dudaba entre dos tallas, cogí la mayor y acerté. Se ajusta genial.\"</p>\n        <span class=\"ely-cm__name\">— Silvia, Málaga</span>\n      </article>\n\n    </div>\n  </div>\n\n  <div class=\"ely-cm__cta\">\n    <a class=\"ely-cm__btn\" href=\"{{ product.url | default: '/' }}\" data-ely-cta>{{ ely_c_cta }}</a>\n  </div>\n\n</section>\n\n<script>\n(function(){\n  var root = document.getElementById('ely-cm-{{ uid }}');\n  if(!root || root.dataset.elyInit) return;\n  root.dataset.elyInit = '1';\n\n  /* ── CTA : remonte au sélecteur d'achat au lieu de recharger la page ── */\n  var cta = root.querySelector('[data-ely-cta]');\n  if(cta){\n    cta.addEventListener('click', function(e){\n      var target = document.querySelector('.main-product-atc, .product-form__submit, product-form, .product__info-wrapper');\n      if(target){\n        e.preventDefault();\n        target.scrollIntoView({behavior:'smooth', block:'center'});\n      }\n    });\n  }\n\n  /* ── Marquee auto-scroll ── */\n  var box = root.querySelector('[data-ely-marquee]');\n  var track = root.querySelector('[data-ely-track]');\n  if(!box || !track) return;\n\n  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  // Duplique les cartes une fois pour boucler sans couture.\n  track.innerHTML += track.innerHTML;\n  var half = 0;\n  function measure(){ half = track.scrollWidth / 2; }\n  measure();\n  window.addEventListener('resize', function(){ measure(); }, {passive:true});\n  if('ResizeObserver' in window) new ResizeObserver(measure).observe(track);\n\n  var SPEED  = parseFloat(box.dataset.speed)  || 0.55;\n  var RESUME = parseInt(box.dataset.resume, 10) || 3000;\n\n  var running = !reduce;\n  var idleTimer = null;\n  var rafId = null;\n\n  function wrap(){\n    if(half <= 0) return;\n    if(box.scrollLeft >= half) box.scrollLeft -= half;\n    else if(box.scrollLeft <= 0) box.scrollLeft += half;\n  }\n\n  function loop(){\n    if(running){\n      box.scrollLeft += SPEED;\n      wrap();\n    }\n    rafId = requestAnimationFrame(loop);\n  }\n\n  function pause(){\n    running = false;\n    clearTimeout(idleTimer);\n    idleTimer = setTimeout(function(){ running = !reduce; }, RESUME);\n  }\n\n  ['pointerdown','touchstart','wheel','mousedown','keydown'].forEach(function(ev){\n    box.addEventListener(ev, pause, {passive:true});\n  });\n  box.addEventListener('scroll', function(){ if(!running) wrap(); }, {passive:true});\n\n  // Pause au survol souris (desktop), reprise à la sortie.\n  if(window.matchMedia && window.matchMedia('(hover: hover)').matches){\n    box.addEventListener('mouseenter', function(){ running = false; clearTimeout(idleTimer); });\n    box.addEventListener('mouseleave', function(){ if(!reduce) running = true; });\n  }\n\n  // Ne tourne que quand la section est visible.\n  if('IntersectionObserver' in window){\n    new IntersectionObserver(function(entries){\n      entries.forEach(function(en){\n        if(en.isIntersecting){ if(!rafId) rafId = requestAnimationFrame(loop); }\n        else if(rafId){ cancelAnimationFrame(rafId); rafId = null; }\n      });\n    }, {threshold:0}).observe(box);\n  } else {\n    rafId = requestAnimationFrame(loop);\n  }\n})();\n</script>",
