      }
    },
    "custom_liquid_4F64wR": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ELORYA · BLOC 7 — Antes/Después + barre de preuve sociale rotative + texte.\n  Placement : nouvelle section \"Liquid personalizado\", sous le bloc 6.\n{%- endcomment -%}\n{%- assign uid = block.id | default: section.id | default: 'ely7' -%}\n\n{%- comment -%} ───────────── RÉGLAGES ───────────── {%- endcomment -%}\n{%- assign ely_ba_img = 'https://cdn.shopify.com/s/files/1/0795/2754/3033/files/hf_20260617_202916_55bb08c7-3701-4979-ac1f-eb49ac4608fb_430x.jpg?v=1786475402' -%}\n\n{%- assign proof1_strong = '1.284 personas' -%}{%- assign proof1_rest = 'lo vieron hoy' -%}\n{%- assign proof2_strong = '190+ unidades'  -%}{%- assign proof2_rest = 'vendidas esta semana' -%}\n{%- assign proof3_pre    = 'En el carrito de' -%}{%- assign proof3_strong = '1,1K personas' -%}\n\n{%- assign ely_ba_title = 'Espalda más lisa al instante' -%}\n{%- assign ely_ba_sub   = 'Suaviza la silueta, mejora la forma y ofrece un ajuste favorecedor bajo cualquier prenda con total comodidad.' -%}\n\n<style>\n  .ely-ba{font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));\n    display:flex;flex-wrap:nowrap;gap:24px;max-width:1000px;margin:32px auto;padding:0 16px;\n    align-items:center;\n    --ely-warm:#B5615A;}\n  .ely-ba *,.ely-ba *::before,.ely-ba *::after{box-sizing:border-box;}\n\n  .ely-ba__col{flex:0 0 42%;border-radius:14px;overflow:hidden;}\n  .ely-ba__fig{position:relative;line-height:0;}\n  .ely-ba__fig img{width:100%;display:block;}\n\n  .ely-ba__banner{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);width:90%;\n    background:rgba(255,255,255,.92);border-radius:30px;display:flex;align-items:center;\n    justify-content:space-between;padding:6px;}\n  .ely-ba__arrow{width:32px;height:32px;flex-shrink:0;border-radius:50%;background:var(--ely-warm);\n    color:#fff;display:flex;align-items:center;justify-content:center;font-size:16px;line-height:1;}\n  .ely-ba__lab{flex:1;text-align:center;font-family:Georgia,'Times New Roman',serif;\n    font-size:20px;line-height:1.2;color:#1A1A1A;}\n\n  .ely-ba__proof{width:100%;background:#FAEBE9;overflow:hidden;display:block;}\n  .ely-ba__track{position:relative;height:38px;}\n  .ely-ba__msg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;\n    gap:6px;font-size:13px;color:#5A2E2A;text-align:center;padding:0 16px;white-space:nowrap;\n    opacity:0;transition:opacity .5s ease;pointer-events:none;}\n  .ely-ba__msg.is-active{opacity:1;}\n  .ely-ba__msg strong{color:var(--ely-warm);font-weight:700;}\n\n  .ely-ba__text{flex:1 1 0;padding:8px 0;}\n  .ely-ba__title{font-size:clamp(20px,2.2vw,26px);font-weight:700;color:#1A1A1A;margin:0 0 10px;line-height:1.25;}\n  .ely-ba__sub{font-size:13px;color:#555;line-height:1.5;margin:0;}\n\n  @media(max-width:768px){\n    .ely-ba{flex-direction:column;gap:16px;}\n    .ely-ba__col{width:100%;flex:none;order:1;}\n    .ely-ba__text{width:100%;flex:none;order:2;}\n    .ely-ba__title{font-size:19px;}\n    .ely-ba__lab{font-size:16px;}\n    .ely-ba__arrow{width:26px;height:26px;font-size:14px;}\n  }\n  @media(max-width:480px){\n    .ely-ba__msg{font-size:12.5px;padding:0 8px;overflow:hidden;text-overflow:ellipsis;}\n  }\n</style>\n\n<div class=\"ely-ba\" id=\"ely-ba-{{ uid }}\">\n\n  <div class=\"ely-ba__col\">\n    <div class=\"ely-ba__fig\">\n      <img src=\"{{ ely_ba_img }}\" alt=\"Antes y después: espalda más lisa con el sujetador Elorya\"\n           loading=\"lazy\" decoding=\"async\">\n      <div class=\"ely-ba__banner\">\n        <span class=\"ely-ba__arrow\" aria-hidden=\"true\">↑</span>\n        <span class=\"ely-ba__lab\">Antes</span>\n        <span class=\"ely-ba__lab\">Después</span>\n        <span class=\"ely-ba__arrow\" aria-hidden=\"true\">↑</span>\n      </div>\n    </div>\n\n    <div class=\"ely-ba__proof\">\n      <div class=\"ely-ba__track\" data-ely-proof>\n        <div class=\"ely-ba__msg is-active\">\n          <span aria-hidden=\"true\">💬</span>\n          <span><strong>{{ proof1_strong }}</strong> {{ proof1_rest }}</span>\n        </div>\n        <div class=\"ely-ba__msg\">\n          <span aria-hidden=\"true\">🚀</span>\n          <span><strong>{{ proof2_strong }}</strong> {{ proof2_rest }}</span>\n        </div>\n        <div class=\"ely-ba__msg\">\n          <span aria-hidden=\"true\">🛒</span>\n          <span>{{ proof3_pre }} <strong>{{ proof3_strong }}</strong></span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ely-ba__text\">\n    <h2 class=\"ely-ba__title\">{{ ely_ba_title }}</h2>\n    <p class=\"ely-ba__sub\">{{ ely_ba_sub }}</p>\n  </div>\n\n</div>\n\n<script>\n(function(){\n  var root = document.getElementById('ely-ba-{{ uid }}');\n  if(!root || root.dataset.elyInit) return;\n  root.dataset.elyInit = '1';\n\n  var track = root.querySelector('[data-ely-proof]');\n  if(!track) return;\n  var msgs = Array.prototype.slice.call(track.querySelectorAll('.ely-ba__msg'));\n  if(msgs.length < 2) return;\n\n  var i = 0, timer = null;\n  function tick(){\n    msgs[i].classList.remove('is-active');\n    i = (i + 1) % msgs.length;\n    msgs[i].classList.add('is-active');\n  }\n  function start(){ if(!timer) timer = setInterval(tick, 3000); }\n  function stop(){ clearInterval(timer); timer = null; }\n\n  // Ne tourne que quand la barre est visible à l'écran.\n  if('IntersectionObserver' in window){\n    new IntersectionObserver(function(entries){\n      entries.forEach(function(en){ en.isIntersecting ? start() : stop(); });\n    }, { threshold: .2 }).observe(track);\n  } else {\n    start();\n  }\n})();\n</script>",
