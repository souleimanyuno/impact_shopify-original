        "liquid_bcVzqT": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}\n  ══════════════════════════════════════════════════════════════\n  ELORYA · BLOC 3 — Pilules de confiance + paiements\n                    + timeline de livraison + carrousel d'avis\n  Placement : section \"Información del producto\",\n              bloc Liquid personalizado JUSTE SOUS \"Añadir al carrito\".\n  Dépendances : aucune. (Le bloc de tokens Elorya est optionnel.)\n  ══════════════════════════════════════════════════════════════\n{%- endcomment -%}\n{%- assign uid = block.id | default: section.id | default: 'ely3' -%}\n\n{%- comment -%} ───────────── RÉGLAGES ───────────── {%- endcomment -%}\n{%- assign ely_t1 = 'Envío Gratis'     -%}\n{%- assign ely_t2 = 'Soporte 24/7'     -%}\n{%- assign ely_t3 = 'Garantía 30 días' -%}\n\n{%- assign ely_pay_img = 'https://cdn.shopify.com/s/files/1/0795/2754/3033/files/Frame_1000003454-1_png_430x.avif?v=1785817587' -%}\n\n{%- comment -%} Délais : x = aujourd'hui · envoi x+1→x+2 · livraison x+5→x+7 {%- endcomment -%}\n{%- assign ship_min = 1 -%}{%- assign ship_max = 2 -%}\n{%- assign deli_min = 5 -%}{%- assign deli_max = 7 -%}\n\n{%- assign rev1_img  = 'https://cdn.shopify.com/s/files/1/0795/2754/3033/files/e8c649eb8ae04223aaed75d4d3a74e75_430x.jpg?v=1786462812' -%}\n{%- assign rev1_text = 'Sujeción perfecta y muy cómoda.' -%}\n{%- assign rev1_name = 'Laura M.' -%}\n\n{%- assign rev2_img  = 'https://cdn.shopify.com/s/files/1/0795/2754/3033/files/56aee308-33d5-43ed-af93-8882c72d8a76_430x.jpg?v=1786462812' -%}\n{%- assign rev2_text = 'No se mueve en todo el día.' -%}\n{%- assign rev2_name = 'María G.' -%}\n\n{%- assign rev3_img  = 'https://cdn.shopify.com/s/files/1/0795/2754/3033/files/e-x-t-e-r-n-a-l_-i-m-a-g-e_-t-o_-i-m-a-g-e-dfac53e6-8ab9-4401-8ffb-e7ef0b290184_430x.jpg?v=1786462813' -%}\n{%- assign rev3_text = 'Realza el busto y queda totalmente invisible.' -%}\n{%- assign rev3_name = 'Carmen R.' -%}\n\n{%- comment -%} ───────────── DATES (rendu serveur, réécrites par le JS) ───────────── {%- endcomment -%}\n{%- assign meses = \"Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre\" | split: \",\" -%}\n{%- assign day    = 86400 -%}\n{%- assign t0     = 'now' | date: '%s' | plus: 0 -%}\n{%- assign ship_a = ship_min | times: day | plus: t0 -%}\n{%- assign ship_b = ship_max | times: day | plus: t0 -%}\n{%- assign deli_a = deli_min | times: day | plus: t0 -%}\n{%- assign deli_b = deli_max | times: day | plus: t0 -%}\n{%- assign m0 = t0     | date: '%-m' | minus: 1 -%}\n{%- assign ma = ship_a | date: '%-m' | minus: 1 -%}\n{%- assign mb = ship_b | date: '%-m' | minus: 1 -%}\n{%- assign mc = deli_a | date: '%-m' | minus: 1 -%}\n{%- assign md = deli_b | date: '%-m' | minus: 1 -%}\n\n<style>\n  .ely-b3{font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));color:#1A1A1A;}\n  .ely-b3 *,.ely-b3 *::before,.ely-b3 *::after{box-sizing:border-box;}\n\n  /* ── 1. Pilules de confiance ── */\n  .ely-b3 .ely-trust{display:flex;justify-content:center;gap:4px;margin:16px 0;flex-wrap:nowrap;}\n  .ely-b3 .ely-trust__item{font-size:10.5px;font-weight:600;color:#222;border:1.5px solid #D0D0D0;\n    border-radius:20px;padding:5px 9px;display:flex;align-items:center;gap:4px;white-space:nowrap;}\n  .ely-b3 .ely-trust__item svg{width:13px;height:13px;flex:0 0 13px;stroke:currentColor;fill:none;\n    stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;display:block;}\n\n  /* ── 2. Badges de paiement ── */\n  .ely-b3 .ely-pay{display:flex;justify-content:center;margin:14px 0 22px;}\n  .ely-b3 .ely-pay img{width:100%;max-width:330px;height:auto;display:block;}\n\n  /* ── 3. Timeline de livraison ── */\n  .ely-b3 .ely-ship{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid #E6E6E6;\n    border-radius:4px;overflow:hidden;margin:0 0 26px;background:#fff;}\n  .ely-b3 .ely-ship__col{position:relative;padding:20px 10px 18px;text-align:center;}\n  .ely-b3 .ely-ship__col + .ely-ship__col{border-left:1px solid #E6E6E6;}\n  .ely-b3 .ely-ship__col + .ely-ship__col::before{content:\"\";position:absolute;left:-7px;top:50%;\n    width:12px;height:12px;margin-top:-6px;background:#fff;\n    border-top:1.5px solid #D8D8D8;border-right:1.5px solid #D8D8D8;transform:rotate(45deg);}\n  .ely-b3 .ely-ship__icon{width:48px;height:48px;border-radius:50%;background:#111;margin:0 auto 14px;\n    display:flex;align-items:center;justify-content:center;}\n  .ely-b3 .ely-ship__icon svg{width:24px;height:24px;stroke:#fff;fill:none;stroke-width:1.8;\n    stroke-linecap:round;stroke-linejoin:round;display:block;}\n  .ely-b3 .ely-ship__title{font-size:15px;font-weight:700;line-height:1.25;margin:0 0 6px;}\n  .ely-b3 .ely-ship__date{font-size:14px;line-height:1.3;margin:0;}\n\n  /* ── 4. Carrousel d'avis ── */\n  .ely-b3 .ely-rev__track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;scrollbar-width:none;}\n  .ely-b3 .ely-rev__track::-webkit-scrollbar{display:none;}\n  .ely-b3 .ely-rev__slide{flex:0 0 100%;scroll-snap-align:center;display:flex;align-items:center;\n    gap:18px;padding:4px 2px;}\n  .ely-b3 .ely-rev__ph{width:62px;height:62px;flex:0 0 62px;border-radius:50%;object-fit:cover;display:block;}\n  .ely-b3 .ely-rev__body{min-width:0;}\n  .ely-b3 .ely-rev__text{font-size:16px;line-height:1.35;font-weight:500;margin:0 0 10px;}\n  .ely-b3 .ely-rev__name{font-size:15px;color:#9B9B9B;margin:0;}\n  .ely-b3 .ely-rev__dots{display:flex;justify-content:center;align-items:center;gap:10px;margin:16px 0 4px;}\n  .ely-b3 .ely-rev__dot{width:9px;height:9px;border-radius:50%;background:#C9C9C9;border:none;padding:0;\n    cursor:pointer;transition:all .2s;}\n  .ely-b3 .ely-rev__dot[aria-current=\"true\"]{width:13px;height:13px;background:#1A1A1A;\n    box-shadow:0 0 0 5px #fff,0 0 0 6.5px #C9C9C9;}\n\n  /* ── Petits écrans ── */\n  @media(max-width:380px){\n    .ely-b3 .ely-trust{gap:3px;}\n    .ely-b3 .ely-trust__item{font-size:9.5px;padding:5px 7px;gap:3px;}\n    .ely-b3 .ely-trust__item svg{width:11px;height:11px;flex:0 0 11px;}\n    .ely-b3 .ely-ship__col{padding:16px 6px 14px;}\n    .ely-b3 .ely-ship__icon{width:40px;height:40px;margin-bottom:10px;}\n    .ely-b3 .ely-ship__icon svg{width:20px;height:20px;}\n    .ely-b3 .ely-ship__title{font-size:13.5px;}\n    .ely-b3 .ely-ship__date{font-size:12.5px;}\n    .ely-b3 .ely-rev__ph{width:54px;height:54px;flex:0 0 54px;}\n    .ely-b3 .ely-rev__text{font-size:14.5px;}\n    .ely-b3 .ely-rev__name{font-size:13.5px;}\n  }\n</style>\n\n<div class=\"ely-b3\" id=\"ely-b3-{{ uid }}\">\n\n  <!-- 1 ─ Pilules -->\n  <div class=\"ely-trust\">\n    <div class=\"ely-trust__item\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M10.5 13.5 3 11l18-7-7 18-2.5-7.5Z\"/><path d=\"m10.5 13.5 4-4\"/></svg>\n      {{ ely_t1 }}\n    </div>\n    <div class=\"ely-trust__item\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 14v-2a8 8 0 0 1 16 0v2\"/><path d=\"M4 14h2.5a1 1 0 0 1 1 1v3.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V14Z\"/><path d=\"M20 14h-2.5a1 1 0 0 0-1 1v3.5a1 1 0 0 0 1 1H19a1 1 0 0 0 1-1V14Z\"/></svg>\n      {{ ely_t2 }}\n    </div>\n    <div class=\"ely-trust__item\">\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 2.6-6.4\"/><path d=\"M3 4v5h5\"/></svg>\n      {{ ely_t3 }}\n    </div>\n  </div>\n\n  <!-- 2 ─ Paiements -->\n  <div class=\"ely-pay\">\n    <img src=\"{{ ely_pay_img }}\" loading=\"lazy\" decoding=\"async\"\n         alt=\"American Express, Maestro, Mastercard, Visa, Apple Pay, Shop Pay\">\n  </div>\n\n  <!-- 3 ─ Timeline -->\n  <div class=\"ely-ship\"\n       data-ship-min=\"{{ ship_min }}\" data-ship-max=\"{{ ship_max }}\"\n       data-deli-min=\"{{ deli_min }}\" data-deli-max=\"{{ deli_max }}\">\n    <div class=\"ely-ship__col\">\n      <div class=\"ely-ship__icon\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/><path d=\"m10 15.5 1.5 1.5 3-3\"/></svg>\n      </div>\n      <p class=\"ely-ship__title\">Pedido realizado</p>\n      <p class=\"ely-ship__date\" data-ely-d0>{{ t0 | date: '%-d' }} {{ meses[m0] }}</p>\n    </div>\n\n    <div class=\"ely-ship__col\">\n      <div class=\"ely-ship__icon\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 8h9v9H2z\"/><path d=\"M11 11h4l3 3v3h-7z\"/><circle cx=\"7\" cy=\"18.5\" r=\"1.6\"/><circle cx=\"16.5\" cy=\"18.5\" r=\"1.6\"/><path d=\"M14 5h7M16 8h5\"/></svg>\n      </div>\n      <p class=\"ely-ship__title\">enviado</p>\n      <p class=\"ely-ship__date\" data-ely-d1>{{ ship_a | date: '%-d' }} {{ meses[ma] }} - {{ ship_b | date: '%-d' }} {{ meses[mb] }}</p>\n    </div>\n\n    <div class=\"ely-ship__col\">\n      <div class=\"ely-ship__icon\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.4\"/></svg>\n      </div>\n      <p class=\"ely-ship__title\">Entregado</p>\n      <p class=\"ely-ship__date\" data-ely-d2>{{ deli_a | date: '%-d' }} {{ meses[mc] }} - {{ deli_b | date: '%-d' }} {{ meses[md] }}</p>\n    </div>\n  </div>\n\n  <!-- 4 ─ Avis -->\n  <div class=\"ely-rev\">\n    <div class=\"ely-rev__track\" data-ely-rev-track>\n      <div class=\"ely-rev__slide\">\n        <img class=\"ely-rev__ph\" src=\"{{ rev1_img }}\" alt=\"{{ rev1_name }}\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"ely-rev__body\">\n          <p class=\"ely-rev__text\">{{ rev1_text }}</p>\n          <p class=\"ely-rev__name\">{{ rev1_name }}</p>\n        </div>\n      </div>\n      <div class=\"ely-rev__slide\">\n        <img class=\"ely-rev__ph\" src=\"{{ rev2_img }}\" alt=\"{{ rev2_name }}\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"ely-rev__body\">\n          <p class=\"ely-rev__text\">{{ rev2_text }}</p>\n          <p class=\"ely-rev__name\">{{ rev2_name }}</p>\n        </div>\n      </div>\n      <div class=\"ely-rev__slide\">\n        <img class=\"ely-rev__ph\" src=\"{{ rev3_img }}\" alt=\"{{ rev3_name }}\" loading=\"lazy\" decoding=\"async\">\n        <div class=\"ely-rev__body\">\n          <p class=\"ely-rev__text\">{{ rev3_text }}</p>\n          <p class=\"ely-rev__name\">{{ rev3_name }}</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ely-rev__dots\" data-ely-rev-dots aria-label=\"Reseñas\">\n      <button type=\"button\" class=\"ely-rev__dot\" aria-current=\"true\"  aria-label=\"Reseña 1\"></button>\n      <button type=\"button\" class=\"ely-rev__dot\" aria-current=\"false\" aria-label=\"Reseña 2\"></button>\n      <button type=\"button\" class=\"ely-rev__dot\" aria-current=\"false\" aria-label=\"Reseña 3\"></button>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function(){\n  var root = document.getElementById('ely-b3-{{ uid }}');\n  if(!root || root.dataset.elyInit) return;\n  root.dataset.elyInit = '1';\n\n  /* ── Dates : recalculées sur l'horloge du visiteur (x, x+1/x+2, x+5/x+7) ── */\n  var box = root.querySelector('.ely-ship');\n  if(box){\n    var MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',\n                 'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];\n    var now = new Date();\n    var add = function(n){ var d = new Date(now); d.setDate(d.getDate() + n); return d; };\n    var fmt = function(d){ return d.getDate() + ' ' + MESES[d.getMonth()]; };\n    var n   = function(k){ return parseInt(box.dataset[k], 10); };\n    box.querySelector('[data-ely-d0]').textContent = fmt(now);\n    box.querySelector('[data-ely-d1]').textContent = fmt(add(n('shipMin'))) + ' - ' + fmt(add(n('shipMax')));\n    box.querySelector('[data-ely-d2]').textContent = fmt(add(n('deliMin'))) + ' - ' + fmt(add(n('deliMax')));\n  }\n\n  /* ── Carrousel d'avis ── */\n  var track = root.querySelector('[data-ely-rev-track]');\n  var dots  = Array.prototype.slice.call(root.querySelectorAll('.ely-rev__dot'));\n  if(track && dots.length){\n    var slides = root.querySelectorAll('.ely-rev__slide').length;\n    var setActive = function(i){\n      dots.forEach(function(d, k){ d.setAttribute('aria-current', k === i ? 'true' : 'false'); });\n    };\n    var raf;\n    track.addEventListener('scroll', function(){\n      cancelAnimationFrame(raf);\n      raf = requestAnimationFrame(function(){\n        var i = Math.round(track.scrollLeft / track.clientWidth);\n        setActive(Math.max(0, Math.min(slides - 1, i)));\n      });\n    }, {passive:true});\n    dots.forEach(function(dot, i){\n      dot.addEventListener('click', function(){\n        track.scrollTo({ left: i * track.clientWidth, behavior:'smooth' });\n        setActive(i);\n      });\n    });\n  }\n})();\n</script>"
          }
        },
        "liquid_fpkEtd": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}\n  ELORYA · BLOC 4A — Accordéons produit.\n  Placement : section \"Información del producto\", bloc Liquid personalizado,\n  APRÈS le carrousel d'avis / AVANT \"Ver todos los detalles\".\n{%- endcomment -%}\n{%- assign uid = block.id | default: section.id | default: 'ely4a' -%}\n\n<style>\n  .ely-faq{font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));\n    max-width:700px;margin:24px auto;color:#1A1A1A;}\n  .ely-faq *,.ely-faq *::before,.ely-faq *::after{box-sizing:border-box;}\n  .ely-faq__item{border-top:1px solid #E5E5E5;}\n  .ely-faq__item:last-child{border-bottom:1px solid #E5E5E5;}\n  .ely-faq__q{width:100%;background:none;border:none;cursor:pointer;display:flex;align-items:center;\n    justify-content:space-between;gap:12px;padding:16px 4px;font-family:inherit;font-size:14px;\n    font-weight:700;color:#1A1A1A;text-align:left;}\n  .ely-faq__chev{flex-shrink:0;transition:transform .25s ease;color:#1A1A1A;}\n  .ely-faq__item.is-open .ely-faq__chev{transform:rotate(180deg);}\n  .ely-faq__a{max-height:0;overflow:hidden;transition:max-height .3s ease;}\n  .ely-faq__inner{padding:0 4px 18px;font-size:13px;line-height:1.6;color:#444;}\n  .ely-faq__inner h3{font-family:inherit;font-size:15px;font-weight:700;color:#1A1A1A;margin:16px 0 8px;}\n  .ely-faq__inner h3:first-child{margin-top:0;}\n  .ely-faq__inner p{margin:0 0 9px;}\n  .ely-faq__inner ul{margin:0 0 9px;padding-left:20px;}\n  .ely-faq__inner li{margin-bottom:5px;}\n</style>\n\n<div class=\"ely-faq\" id=\"ely-faq-{{ uid }}\">\n\n  <div class=\"ely-faq__item\">\n    <button type=\"button\" class=\"ely-faq__q\" aria-expanded=\"false\" aria-controls=\"ely-a1-{{ uid }}\">\n      <span>¿Qué talla debo elegir?</span>\n      <svg class=\"ely-faq__chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n    </button>\n    <div class=\"ely-faq__a\" id=\"ely-a1-{{ uid }}\">\n      <div class=\"ely-faq__inner\">\n        <h3>¿No sabes cuál es tu talla?</h3>\n        <p>Nuestro sujetador sin aros es muy elástico y se adapta a distintas formas de pecho, de la copa A a la E.</p>\n\n        <h3>Equivalencia rápida</h3>\n        <ul>\n          <li><strong>70A–75C → S</strong></li>\n          <li><strong>75D–80C → M</strong></li>\n          <li><strong>80D–85C → L</strong></li>\n          <li><strong>85D–100E → XL</strong></li>\n        </ul>\n\n        <h3>Ejemplos prácticos</h3>\n        <ul>\n          <li>Si usas 70B, 70C, 75A o 75C → talla <strong>S</strong></li>\n          <li>Si usas 75D, 80A, 80B o 80C → talla <strong>M</strong></li>\n          <li>Si usas 80D, 80E, 85A o 85C → talla <strong>L</strong></li>\n          <li>Si usas 85D, 90C, 95B o 100C → talla <strong>XL</strong></li>\n        </ul>\n\n        <h3>Cómo medirte</h3>\n        <ul>\n          <li>Mide el contorno del pecho por la parte más ancha del busto.</li>\n          <li>Compara tu medida con la tabla de arriba.</li>\n          <li>¿Copa grande o prefieres ir más holgada? Sube una talla.</li>\n        </ul>\n\n        <h3>Si dudas entre dos tallas</h3>\n        <p>Elige siempre la mayor. Ganas comodidad y la sujeción queda igual de firme.</p>\n\n        <h3>Cambio de talla garantizado</h3>\n        <p>Si no aciertas, la cambias sin complicaciones. Escríbenos y te ayudamos a encontrar tu talla ideal.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ely-faq__item\">\n    <button type=\"button\" class=\"ely-faq__q\" aria-expanded=\"false\" aria-controls=\"ely-a2-{{ uid }}\">\n      <span>Garantía de Confianza de 30 Días</span>\n      <svg class=\"ely-faq__chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n    </button>\n    <div class=\"ely-faq__a\" id=\"ely-a2-{{ uid }}\">\n      <div class=\"ely-faq__inner\">\n        <p>Pruébalo 30 días. Sin riesgo.</p>\n        <p>Si no te convence, te devolvemos el 100% de tu dinero.</p>\n        <p>Sin preguntas. Sin complicaciones.</p>\n        <p>Y además, un año de garantía de calidad.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ely-faq__item\">\n    <button type=\"button\" class=\"ely-faq__q\" aria-expanded=\"false\" aria-controls=\"ely-a3-{{ uid }}\">\n      <span>¿Sujeta realmente el pecho?</span>\n      <svg class=\"ely-faq__chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n    </button>\n    <div class=\"ely-faq__a\" id=\"ely-a3-{{ uid }}\">\n      <div class=\"ely-faq__inner\">\n        <p>Sí. Su banda ancha con doble refuerzo reparte el peso en todo el contorno: sujeta de verdad, sin aros y sin apretar.</p>\n        <p>Lo notas desde el primer día: más soporte, más forma, más seguridad.</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"ely-faq__item\">\n    <button type=\"button\" class=\"ely-faq__q\" aria-expanded=\"false\" aria-controls=\"ely-a4-{{ uid }}\">\n      <span>¿Y si la talla no me queda bien?</span>\n      <svg class=\"ely-faq__chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n    </button>\n    <div class=\"ely-faq__a\" id=\"ely-a4-{{ uid }}\">\n      <div class=\"ely-faq__inner\">\n        <p>No pasa nada.</p>\n        <p>Si no te queda perfecta, la cambias fácilmente.</p>\n        <p>Y si prefieres asegurarte antes de pedir, escríbenos: te decimos tu talla en un minuto.</p>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function(){\n  var root = document.getElementById('ely-faq-{{ uid }}');\n  if(!root || root.dataset.elyInit) return;\n  root.dataset.elyInit = '1';\n\n  var items = Array.prototype.slice.call(root.querySelectorAll('.ely-faq__item'));\n\n  items.forEach(function(item){\n    var btn = item.querySelector('.ely-faq__q');\n    var ans = item.querySelector('.ely-faq__a');\n    btn.addEventListener('click', function(){\n      var open = item.classList.toggle('is-open');\n      btn.setAttribute('aria-expanded', open ? 'true' : 'false');\n      ans.style.maxHeight = open ? ans.scrollHeight + 'px' : null;\n    });\n  });\n\n  // Recalcule la hauteur des panneaux ouverts (rotation, redimensionnement).\n  var t;\n  window.addEventListener('resize', function(){\n    clearTimeout(t);\n    t = setTimeout(function(){\n      items.forEach(function(item){\n        if(item.classList.contains('is-open')){\n          var ans = item.querySelector('.ely-faq__a');\n          ans.style.maxHeight = ans.scrollHeight + 'px';\n        }\n      });\n    }, 150);\n  }, {passive:true});\n})();\n</script>\n\n{%- comment -%}\n  ELORYA · BLOC 4B — \"Amado por…\" + carrousel vidéo.\n  Placement : nouvelle section \"Liquid personalizado\", JUSTE SOUS la section produit.\n{%- endcomment -%}\n{%- assign uid = block.id | default: section.id | default: 'ely4b' -%}\n\n{%- assign ely_vid_title = 'Amado por +18.000 mujeres' -%}\n{%- assign vid1 = 'https://cdn.shopify.com/videos/c/o/v/a3d998dddf0e4ab3831f7956978a6632.mp4' -%}\n{%- assign vid2 = 'https://cdn.shopify.com/videos/c/o/v/3c4885419d894550b66c97039fad5632.mp4' -%}\n{%- assign vid3 = 'https://cdn.shopify.com/videos/c/o/v/0ac2128aff7643549dc00fcd01b4c30a.mp4' -%}\n\n<style>\n  .ely-vc{width:100%;overflow:hidden;margin:0;padding:0;\n    font-family:var(--ely-font,var(--elorya-font,'Barlow','Montserrat',sans-serif));}\n  .ely-vc *,.ely-vc *::before,.ely-vc *::after{box-sizing:border-box;}\n  .ely-vc__title{text-align:center;font-size:clamp(19px,5.6vw,26px);font-weight:700;color:#000;\n    margin:14px 0 2px;padding:0 14px;line-height:1.25;text-wrap:balance;}\n  .ely-vc__track{display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;\n    gap:6px;padding:6px 8px;-webkit-overflow-scrolling:touch;scrollbar-width:none;\n    overscroll-behavior-x:contain;touch-action:pan-x;}\n  .ely-vc__track::-webkit-scrollbar{display:none;}\n  .ely-vc__slide{position:relative;flex:0 0 auto;width:36%;aspect-ratio:9/16;scroll-snap-align:center;\n    border-radius:10px;overflow:hidden;background:#000;transform:translateZ(0);\n    -webkit-backface-visibility:hidden;}\n  .ely-vc__video{width:100%;height:100%;object-fit:cover;display:block;cursor:pointer;background:#000;}\n  .ely-vc__btn{position:absolute;bottom:8px;left:8px;width:32px;height:32px;border-radius:50%;\n    background:rgba(0,0,0,.55);border:none;display:flex;align-items:center;justify-content:center;\n    cursor:pointer;padding:0;z-index:2;-webkit-tap-highlight-color:transparent;}\n  @media(min-width:768px){\n    .ely-vc__title{margin:28px 0 6px;}\n    .ely-vc__slide{width:22%;}\n  }\n</style>\n\n<div class=\"ely-vc\" id=\"ely-vc-{{ uid }}\">\n  <h2 class=\"ely-vc__title\">{{ ely_vid_title }}</h2>\n\n  <div class=\"ely-vc__track\" data-ely-vc-track>\n    {%- assign vids = vid1 | append: '|' | append: vid2 | append: '|' | append: vid3 | split: '|' -%}\n    {%- for v in vids -%}\n      <div class=\"ely-vc__slide\" data-ely-vc-src=\"{{ v }}\">\n        <video class=\"ely-vc__video\" playsinline muted preload=\"none\"></video>\n        <button type=\"button\" class=\"ely-vc__btn\" aria-label=\"Reproducir vídeo\">\n          <svg class=\"ely-ic-play\"  width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"white\" aria-hidden=\"true\"><polygon points=\"6,4 20,12 6,20\"/></svg>\n          <svg class=\"ely-ic-pause\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"white\" aria-hidden=\"true\" style=\"display:none\"><rect x=\"5\" y=\"4\" width=\"4\" height=\"16\"/><rect x=\"15\" y=\"4\" width=\"4\" height=\"16\"/></svg>\n        </button>\n      </div>\n    {%- endfor -%}\n  </div>\n</div>\n\n<script>\n(function(){\n  var wrap = document.getElementById('ely-vc-{{ uid }}');\n  if(!wrap || wrap.dataset.elyInit) return;\n  wrap.dataset.elyInit = '1';\n\n  var track  = wrap.querySelector('[data-ely-vc-track]');\n  var slides = Array.prototype.slice.call(wrap.querySelectorAll('.ely-vc__slide'));\n\n  function sync(slide){\n    var v = slide.querySelector('.ely-vc__video');\n    slide.querySelector('.ely-ic-play').style.display  = v.paused ? '' : 'none';\n    slide.querySelector('.ely-ic-pause').style.display = v.paused ? 'none' : '';\n  }\n  function pauseAll(except){\n    slides.forEach(function(s){\n      if(s !== except){\n        var v = s.querySelector('.ely-vc__video');\n        if(!v.paused){ v.pause(); sync(s); }\n      }\n    });\n  }\n  function load(slide){\n    var v = slide.querySelector('.ely-vc__video');\n    if(v.querySelector('source')) return;\n    var src = document.createElement('source');\n    src.src  = slide.getAttribute('data-ely-vc-src');\n    src.type = 'video/mp4';\n    v.appendChild(src);\n    v.load();\n  }\n\n  slides.forEach(function(slide){\n    var v   = slide.querySelector('.ely-vc__video');\n    var btn = slide.querySelector('.ely-vc__btn');\n    v.muted = true; v.volume = 0;\n\n    btn.addEventListener('click', function(e){\n      e.stopPropagation();\n      load(slide);\n      if(v.paused){\n        pauseAll(slide);\n        v.muted = true;\n        var p = v.play();\n        if(p && p.catch) p.catch(function(){});\n      } else { v.pause(); }\n      sync(slide);\n    });\n\n    v.addEventListener('click', function(){ btn.click(); });\n    ['play','pause','ended'].forEach(function(ev){\n      v.addEventListener(ev, function(){ sync(slide); });\n    });\n  });\n\n  // Charge la 1re frame quand la vignette entre dans le viewport, met en pause quand elle sort.\n  if('IntersectionObserver' in window){\n    var obs = new IntersectionObserver(function(entries){\n      entries.forEach(function(en){\n        var slide = en.target, v = slide.querySelector('.ely-vc__video');\n        if(en.isIntersecting){ load(slide); }\n        else if(!v.paused){ v.pause(); sync(slide); }\n      });\n    }, { root: track, threshold: .5 });\n    slides.forEach(function(s){ obs.observe(s); });\n  } else {\n    slides.forEach(load);\n  }\n})();\n</script>"
          }
        }
